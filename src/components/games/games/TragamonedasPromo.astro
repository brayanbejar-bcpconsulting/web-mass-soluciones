</style>

<script define:vars={{ apiConfigUrl, apiPlayUrl }}>
  (function () {
    "use strict";

    /* CONSTANTES ACTUALIZADAS para altura 250px */
    const SYM_H = 83.33; // 250px / 3 símbolos visibles
    const VIEWPORT_H = 250;
    const PAYLINE_TOP = SYM_H; // Centro del símbolo del medio

    const BASE = ["💲", "🔔", "🍒", "⭐", "🪙", "🎁", "💎", "7️⃣"];
    const BASE_H = BASE.length * SYM_H; // 666.64px (un ciclo)
    const EXTENDED_H = BASE_H * 6; // 3999.84px (6 ciclos completos)

    // Mapeo de símbolos API a emojis
    const SYMBOL_MAP = {
      C: "🍒",
      B: "🔔",
      S: "⭐",
      D: "💎",
      M: "💲",
      G: "🎁",
      W: "🪙",
      "7": "7️⃣",
    };

    const el = {
      inputView: document.getElementById("classic-input-view"),
      machineView: document.getElementById("classic-machine-view"),
      resultView: document.getElementById("classic-result-view"),
      amountInput: document.getElementById("classic-amount-input"),
      continueBtn: document.getElementById("classic-continue-btn"),
      leverBtn: document.getElementById("classic-lever-btn"),
      quickBtns: document.querySelectorAll(".classic-quick-amount"),
      strips: [
        document.getElementById("classic-reel-1"),
        document.getElementById("classic-reel-2"),
        document.getElementById("classic-reel-3"),
      ],
      frames: [
        document.getElementById("classic-reel-frame-1"),
        document.getElementById("classic-reel-frame-2"),
        document.getElementById("classic-reel-frame-3"),
      ],
      sym1: document.getElementById("classic-symbol-1"),
      sym2: document.getElementById("classic-symbol-2"),
      sym3: document.getElementById("classic-symbol-3"),
      couponCode: document.getElementById("classic-coupon-code"),
      couponDesc: document.getElementById("classic-coupon-description"),
      expDate: document.getElementById("classic-expiration-date"),
      claimBtn: document.getElementById("classic-claim-btn"),
      claimText: document.getElementById("classic-claim-text"),
      statusText: document.getElementById("classic-status-text"),
      container: document.getElementById("classic-promo-container"),
      card: document.getElementById("classic-promo-card"),
      backdrop: document.getElementById("classic-mobile-backdrop"),
      tab: document.getElementById("classic-promo-tab"),
      closeBtn: document.getElementById("classic-close-btn"),
      machineBody: document.getElementById("classic-machine-body"),
      payline: document.getElementById("classic-payline"),
    };

    const state = {
      autoHideTimer: null,
      hasInteracted: false,
      isPlaying: false,
      currentAmount: 2500,
      gameConfig: null,
      slotsGame: null,
      gameId: null,
      reelY: [-666.64, -833.3, -749.97],
    };

    // ═══════════════════════════════════════════════════════════════
    // CARGAR CONFIGURACIÓN DESDE API
    // ═══════════════════════════════════════════════════════════════
    async function loadGameConfig() {
      try {
        const response = await fetch(apiConfigUrl);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        const data = await response.json();
        console.log("Configuración de la API recibida:", data);

        // Buscar el PRIMER juego de tipo SLOTS activo (solo uno por tipo)
        state.slotsGame = data.games.find(
          (game) => game.game_type === "SLOTS" && game.active,
        );

        if (state.slotsGame) {
          console.log("Juego de slots encontrado:", state.slotsGame);
          state.gameId = state.slotsGame.id; // Guardar el gameId dinámico
          state.gameConfig = data;
        } else {
          throw new Error("No se encontró ningún juego de SLOTS activo");
        }
      } catch (error) {
        console.error("Error al cargar la configuración del juego:", error);
        // Fallback a configuración local si falla la API
        state.slotsGame = {
          id: "fallback",
          name: "Tragamonedas Classic",
          game_type: "SLOTS",
          active: true,
          tiers: [
            {
              id: "tier_1",
              label: "basic",
              visual_symbols: ["C", "C", "C"],
            },
            {
              id: "tier_2",
              label: "mid",
              visual_symbols: ["B", "B", "B"],
            },
            {
              id: "tier_3",
              label: "top",
              visual_symbols: ["S", "S", "S"],
            },
          ],
        };
        state.gameId = state.slotsGame.id;
      }
    }

    function showView(name) {
      [el.inputView, el.machineView, el.resultView].forEach((v) => {
        if (v) {
          v.classList.add("hidden");
          v.style.display = "none";
        }
      });
      const m = {
        input: el.inputView,
        machine: el.machineView,
        result: el.resultView,
      };
      if (m[name]) {
        m[name].classList.remove("hidden");
        m[name].style.display = "block";

        if (name === "machine") {
          void m[name].offsetHeight;
          el.strips.forEach((strip, i) => {
            strip.style.transform = `translateY(${state.reelY[i]}px)`;
          });
        }
      }
    }

    function openPromo() {
      if (state.autoHideTimer) {
        clearTimeout(state.autoHideTimer);
        state.autoHideTimer = null;
      }
      if (window.innerWidth < 768) {
        if (el.container) el.container.classList.add("mobile-popup-active");
        if (el.backdrop) el.backdrop.classList.add("backdrop-active");
      } else {
        if (el.card) el.card.classList.add("state-open-card");
      }
      if (el.tab) el.tab.classList.add("state-hide-tab");
    }

    function closePromo() {
      if (el.container) el.container.classList.remove("mobile-popup-active");
      if (el.backdrop) el.backdrop.classList.remove("backdrop-active");
      if (el.card) el.card.classList.remove("state-open-card");
      if (el.tab) el.tab.classList.remove("state-hide-tab");
    }

    function targetYForSymbol(sym) {
      const idx = BASE.indexOf(sym);
      return PAYLINE_TOP - (BASE.length + idx) * SYM_H;
    }

    function normalizeY(y) {
      const targetOffset = y % BASE_H;
      let normalized = y;
      const minY = -EXTENDED_H + VIEWPORT_H;
      const maxY = -PAYLINE_TOP;

      while (normalized < minY) normalized += BASE_H;
      while (normalized > maxY) normalized -= BASE_H;

      return normalized;
    }

    function spinReel(reelIdx, targetSym, duration) {
      return new Promise((resolve) => {
        const strip = el.strips[reelIdx];
        const frame = el.frames[reelIdx];
        const startY = state.reelY[reelIdx];
        const targetY = targetYForSymbol(targetSym);

        let travel = targetY - startY;
        while (travel > -BASE_H * 3) travel -= BASE_H;
        travel -= BASE_H * (3 + Math.floor(Math.random() * 2));

        const rawEnd = startY + travel;
        const finalY = normalizeY(rawEnd);
        const actualTravel = finalY - startY;

        const overshoot = 15;
        const t0 = performance.now();

        function easeOutExpo(t) {
          return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        }

        function easeOutBack(t) {
          const c1 = 1.70158;
          const c3 = c1 + 1;
          return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
        }

        function easeInCubic(t) {
          return t * t * t;
        }

        function animate(now) {
          const elapsed = now - t0;
          const progress = Math.min(elapsed / duration, 1);
          let pos, blurAmount;

          if (progress < 0.1) {
            const t = progress / 0.1;
            const eased = easeInCubic(t);
            pos = startY + actualTravel * eased * 0.08;
            blurAmount = eased * 7;
          } else if (progress < 0.8) {
            const t = (progress - 0.1) / 0.7;
            const eased = t;
            pos = startY + actualTravel * (0.08 + eased * 0.72);
            blurAmount = 7;
          } else if (progress < 0.92) {
            const t = (progress - 0.8) / 0.12;
            const eased = easeOutExpo(t);
            pos = startY + actualTravel * (0.8 + eased * 0.15);
            blurAmount = 7 * (1 - eased);
          } else {
            const t = (progress - 0.92) / 0.08;
            const eased = easeOutBack(t);
            const nearEnd = startY + actualTravel * 0.95;
            pos = finalY - (finalY - nearEnd) * (1 - eased);
            blurAmount = 0;
          }

          strip.style.transform = `translateY(${pos}px)`;
          strip.style.filter =
            blurAmount > 0.5 ? `blur(${blurAmount}px)` : "none";

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            strip.style.filter = "none";
            strip.style.transform = `translateY(${finalY}px)`;
            state.reelY[reelIdx] = finalY;

            frame.classList.remove("reel-shake");
            void frame.offsetWidth;
            frame.classList.add("reel-shake");

            setTimeout(() => {
              resolve(finalY);
            }, 50);
          }
        }

        requestAnimationFrame(animate);
      });
    }

    async function playSlotAnimation(targets) {
      el.statusText.textContent = "¡Girando los carretes!";

      el.machineBody.classList.remove("machine-shake");
      void el.machineBody.offsetWidth;
      el.machineBody.classList.add("machine-shake");

      const d0 = 2500 + Math.random() * 400;
      const d1 = d0 + 700 + Math.random() * 300;
      const d2 = d1 + 700 + Math.random() * 300;

      const p0 = spinReel(0, targets[0], d0);
      const p1 = spinReel(1, targets[1], d1);
      const p2 = spinReel(2, targets[2], d2);

      setTimeout(() => {
        el.statusText.textContent = "Primer carrete... 🎯";
      }, d0 + 100);

      setTimeout(() => {
        el.statusText.textContent = "Dos carretes... ¡vamos! 🔥";
      }, d1 + 100);

      setTimeout(() => {
        el.statusText.textContent = "Último carrete... 🤞";
      }, d2 - 300);

      await Promise.all([p0, p1, p2]);

      await new Promise((r) => setTimeout(r, 400));
      el.payline.classList.remove("payline-flash");
      void el.payline.offsetWidth;
      el.payline.classList.add("payline-flash");

      el.statusText.textContent = "¡VERIFICANDO PREMIO! ✨";
      await new Promise((r) => setTimeout(r, 1200));
    }

    async function playGame() {
      try {
        el.statusText.textContent = "Conectando con el servidor...";

        const response = await fetch(apiPlayUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            gameId: state.gameId, // Usar el gameId dinámico del endpoint
          }),
        });

        const result = await response.json();
        console.log("Resultado del juego:", result);
        
        // Handle rate limited response
        if (result.error === "rate_limited") {
          const nextPlayAt = result.cooldown?.next_play_at 
            ? new Date(result.cooldown.next_play_at).toLocaleString("es-PE", { dateStyle: "short", timeStyle: "short" })
            : "mañana";
          return { 
            rateLimited: true, 
            message: `¡Ya jugaste hoy! Vuelve: ${nextPlayAt}` 
          };
        }

        if (!response.ok) {
          throw new Error(`Error del servidor: ${response.status}`);
        }

        return result;
      } catch (error) {
        console.error("Error al jugar:", error);
        throw error;
      }
    }

    async function pullLever() {
      if (state.isPlaying) return;
      if (!state.slotsGame) {
        el.statusText.textContent = "Error: Juego no configurado";
        return;
      }

      state.isPlaying = true;

      el.leverBtn.classList.add("pulling");
      await new Promise((r) => setTimeout(r, 220));
      el.leverBtn.classList.remove("pulling");
      await new Promise((r) => setTimeout(r, 80));

      try {
        // Llamar a la API para jugar
        const gameResult = await playGame();
        
        // Check for rate limited
        if (gameResult.rateLimited) {
          el.statusText.textContent = gameResult.message;
          el.statusText.style.color = "#FFC107";
          state.isPlaying = false;
          return;
        }

        // Convertir símbolos de la API a emojis
        const symbols = gameResult.result.visual_symbols.map(
          (sym) => SYMBOL_MAP[sym] || sym,
        );

        // Guardar resultado en localStorage
        const savedResult = {
          token: gameResult.claim.token,
          tierLabel: gameResult.result?.tier_label || 'especial',
          expiresAt: gameResult.claim.expires_at,
          visualSymbols: gameResult.result.visual_symbols
        };
        localStorage.setItem('md_slots_saved_result', JSON.stringify(savedResult));
        
        // Animar los carretes con los símbolos ganadores
        await playSlotAnimation(symbols);

        // Mostrar resultado
        showWinResult(gameResult);
      } catch (error) {
        console.error("Error en el juego:", error);
        el.statusText.textContent = "Error al conectar. Inténtalo de nuevo.";
        state.isPlaying = false;
      }
    }

    function showWinResult(result) {
      // Convertir símbolos de la API a emojis
      const symbols = result.result.visual_symbols.map(
        (sym) => SYMBOL_MAP[sym] || sym,
      );

      el.sym1.textContent = symbols[0];
      el.sym2.textContent = symbols[1];
      el.sym3.textContent = symbols[2];

      el.couponCode.textContent = result.claim.token;
      el.couponDesc.textContent = `Cupón ganador - Tier: ${result.result.tier_label}`;

      // Formatear fecha de expiración
      const expDate = new Date(result.claim.expires_at);
      el.expDate.textContent = expDate.toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });

      showView("result");

      if (typeof confetti === "function") {
        const end = Date.now() + 2500;
        (function f() {
          confetti({
            particleCount: 3,
            angle: 60,
            spread: 50,
            origin: { x: 0, y: 0.6 },
            colors: ["#1E88E5", "#facc15", "#1976D2"],
          });
          confetti({
            particleCount: 3,
            angle: 120,
            spread: 50,
            origin: { x: 1, y: 0.6 },
            colors: ["#1E88E5", "#facc15", "#1976D2"],
          });
          if (Date.now() < end) requestAnimationFrame(f);
        })();
      }
      state.isPlaying = false;
    }

    async function init() {
      // Cargar configuración desde API
      await loadGameConfig();
      
      // Registrar event listeners básicos PRIMERO (antes de chequear resultado guardado)
      el.tab?.addEventListener("click", (e) => {
        e.stopPropagation();
        state.hasInteracted = true;
        openPromo();
      });

      el.closeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        state.hasInteracted = true;
        closePromo();
      });

      el.backdrop?.addEventListener("click", () => closePromo());

      el.container?.addEventListener("mouseenter", () => {
        if (!state.isPlaying) {
          openPromo();
          state.hasInteracted = true;
        }
      });
      
      // Cargar resultado guardado si existe
      const savedResult = localStorage.getItem('md_slots_saved_result');
      if (savedResult) {
        try {
          const result = JSON.parse(savedResult);
          // Verificar si no ha expirado
          const expiresAt = new Date(result.expiresAt);
          if (expiresAt > new Date()) {
            // Mostrar resultado guardado
            const mockResult = {
              claim: { token: result.token, expires_at: result.expiresAt },
              result: { 
                tier_label: result.tierLabel, 
                visual_symbols: result.visualSymbols 
              }
            };
            showWinResult(mockResult);
            return; // No continuar con la inicialización de juego
          } else {
            // Limpiar resultado expirado
            localStorage.removeItem('md_slots_saved_result');
          }
        } catch (e) {
          console.error('Error loading saved result:', e);
        }
      }

      // Inicializar posiciones
      el.strips.forEach((strip, i) => {
        const currentTransform = strip.style.transform;
        const match = currentTransform.match(/translateY\(([-\d.]+)px\)/);
        if (match) {
          state.reelY[i] = parseFloat(match[1]);
        }
      });

      // Event listeners de juego (solo si no hay resultado guardado)
      el.quickBtns?.forEach((btn) =>
        btn.addEventListener("click", () => {
          if (el.amountInput) el.amountInput.value = btn.dataset.amount;
        }),
      );

      el.continueBtn?.addEventListener("click", () => showView("machine"));
      el.leverBtn?.addEventListener("click", pullLever);

      el.claimBtn?.addEventListener("click", () => {
        const code = el.couponCode.innerText;
        navigator.clipboard
          .writeText(code)
          .then(() => {
            el.claimText.innerText = "¡Copiado!";
            setTimeout(() => {
              window.location.href = "https://app.market-dollar.com/dashboard";
            }, 1000);
          })
          .catch(() => {
            const t = document.createElement("textarea");
            t.value = code;
            document.body.appendChild(t);
            t.select();
            document.execCommand("copy");
            document.body.removeChild(t);
            el.claimText.innerText = "¡Copiado!";
            setTimeout(() => {
              window.location.href = "https://app.market-dollar.com/dashboard";
            }, 1000);
          });
      });

      showView("input");

      // Auto-open en desktop
      setTimeout(() => {
        if (!state.hasInteracted && window.innerWidth >= 768) {
          openPromo();
          state.autoHideTimer = setTimeout(() => {
            if (!state.hasInteracted && !state.isPlaying) closePromo();
          }, 8000);
        }
      }, 2000);
    }

    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>
