---
// ClassicSlotMachine.astro - Tragamonedas con API Real
const API_BASE = import.meta.env.MARKET_DOLLAR_API_URL || "https://app.market-dollar.com";

const {
  apiConfigUrl = `${API_BASE}/api/v1/games/config`,
  apiPlayUrl = `${API_BASE}/api/v1/games/play-guest`,
} = Astro.props;

const SYMBOLS = ["💲", "🔔", "🍒", "⭐", "🪙", "🎁", "💎", "7️⃣"];
const EXTENDED = [
  ...SYMBOLS,
  ...SYMBOLS,
  ...SYMBOLS,
  ...SYMBOLS,
  ...SYMBOLS,
  ...SYMBOLS,
];
---

<script
  src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"
></script>

<!-- Backdrop mobile -->
<div
  id="classic-mobile-backdrop"
  class="fixed inset-0 bg-black/90 z-[40] hidden opacity-0 transition-opacity duration-300 md:hidden backdrop-blur-md"
  aria-hidden="true"
>
</div>

<!-- Contenedor principal - MÁS COMPACTO -->
<div
  class="fixed left-0 z-[50] flex items-center font-sans transition-all duration-300
          bottom-4 scale-75 origin-bottom-left
          md:top-1/2 md:bottom-auto md:scale-90 md:-translate-y-1/2"
  id="classic-promo-container"
>
  <!-- Tab lateral - MÁS PEQUEÑO -->
  <div
    id="classic-promo-tab"
    class="relative overflow-hidden bg-gradient-to-br from-[#0A2540] via-[#1565C0] to-[#0A2540] h-44 w-12 rounded-r-2xl flex flex-col items-center justify-center cursor-pointer shadow-[0_0_30px_rgba(30,136,229,0.6)] transition-all duration-500 border-r-[3px] border-y-[3px] border-[#1E88E5] z-20 hover:w-16 hover:shadow-[0_0_50px_rgba(30,136,229,0.9)] active:scale-95 group"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent animate-shine"
    >
    </div>
    <div class="relative mb-3">
      <div
        class="absolute inset-0 blur-lg bg-gradient-to-br from-[#1E88E5] to-[#facc15] animate-pulse opacity-60"
      >
      </div>
      <span
        class="relative text-4xl animate-float filter drop-shadow-[0_0_8px_rgba(30,136,229,1)]"
        >🎰</span
      >
    </div>
    <span
      class="uppercase font-black text-[10px] text-[#1E88E5] [writing-mode:vertical-lr] tracking-[0.4em] drop-shadow-[0_0_8px_rgba(30,136,229,0.8)] transform rotate-180 group-hover:text-[#facc15] transition-colors"
    >
      JUEGA
    </span>
  </div>

  <!-- Card principal - MÁS COMPACTA -->
  <div
    id="classic-promo-card"
    class="absolute left-0 flex flex-col bg-gradient-to-br from-[#0A2540] via-[#1565C0] to-[#0A2540] rounded-r-2xl shadow-[40px_15px_100px_rgba(0,0,0,0.9)]
            w-[300px] md:w-[380px]
            translate-x-[-110%] opacity-0 transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]
            border-l-0 z-10 pointer-events-none overflow-hidden backdrop-blur-2xl border-[3px] border-[#1E88E5]"
  >
    <!-- Close button -->
    <button
      id="classic-close-btn"
      class="absolute top-3 right-3 z-30 bg-gradient-to-br from-red-600/20 to-red-700/20 hover:from-red-500/40 hover:to-red-600/40 text-red-300 rounded-lg w-8 h-8 flex items-center justify-center text-xs font-bold transition-all duration-300 cursor-pointer shadow-[0_0_15px_rgba(239,68,68,0.3)] backdrop-blur-sm border border-red-500/30 hover:scale-110 group"
    >
      <span class="group-hover:rotate-90 transition-transform duration-300"
        >✕</span
      >
    </button>

    <div
      class="bg-gradient-to-br from-[#0A2540]/90 via-[#1565C0]/80 to-[#0A2540]/90 backdrop-blur-xl rounded-r-[16px] w-full border-2 border-[#1E88E5]/40 overflow-y-auto overflow-x-hidden relative z-10"
      style="min-height: 420px; max-height: 85vh;"
    >
      <!-- ─── INPUT VIEW ─── -->
      <div id="classic-input-view" class="w-full px-3 py-4">
        <div class="flex flex-col items-center text-center w-full">
          <div class="relative mb-4 w-full">
            <div
              class="relative bg-gradient-to-b from-[#1E88E5] via-[#1976D2] to-[#1565C0] rounded-xl p-3 mb-4 shadow-[0_6px_24px_rgba(0,0,0,0.8)] border-[3px] border-[#facc15]"
            >
              <div
                class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-black/20 rounded-xl"
              >
              </div>
              <h3
                class="relative text-white font-black text-xl uppercase tracking-wider drop-shadow-[2px_2px_4px_rgba(0,0,0,0.5)]"
              >
                ⭐ Market Dollar ⭐
              </h3>
              <div
                class="relative text-[#facc15] font-bold text-[10px] uppercase tracking-[0.2em] mt-1"
              >
                Casa de Cambio Online
              </div>
            </div>
            <div class="flex items-center justify-center gap-2 mb-3">
              <div
                class="h-[2px] w-10 bg-gradient-to-r from-transparent to-[#1E88E5]"
              >
              </div>
              <p
                class="text-[#1E88E5] text-xs font-bold uppercase tracking-widest"
              >
                Ingresa tu Monto
              </p>
              <div
                class="h-[2px] w-10 bg-gradient-to-l from-transparent to-[#1E88E5]"
              >
              </div>
            </div>
          </div>

          <div class="w-full mb-4">
            <div
              class="relative bg-gradient-to-b from-[#0A2540] to-[#1565C0] rounded-lg p-4 border-[3px] border-[#1E88E5] shadow-[0_15px_50px_rgba(0,0,0,0.9)]"
            >
              <label class="text-[#1E88E5] text-xs font-semibold mb-2 block"
                >Monto en USD</label
              >
              <div class="relative">
                <span
                  class="absolute left-3 top-1/2 -translate-y-1/2 text-[#1E88E5]/80 text-xl font-bold"
                  >$</span
                >
                <input
                  type="number"
                  id="classic-amount-input"
                  min="100"
                  max="25000"
                  step="100"
                  value="2500"
                  class="w-full bg-gradient-to-br from-[#0A2540] to-[#1565C0] border-2 border-[#1E88E5] rounded-lg px-10 py-3 text-[#1E88E5] text-2xl font-bold text-center focus:outline-none focus:border-[#00C853] focus:shadow-[0_0_15px_rgba(0,200,83,0.4)] transition-all"
                />
                <span
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-[#1E88E5]/80 text-sm font-semibold"
                  >USD</span
                >
              </div>
              <div class="flex gap-2 mt-3 justify-center flex-wrap">
                {
                  [2500, 5000, 10000, 15000, 20000].map((amt) => (
                    <button
                      class="classic-quick-amount px-3 py-1.5 bg-gradient-to-b from-[#1E88E5] to-[#1565C0] border-2 border-[#facc15]/30 rounded-lg text-white text-xs font-bold hover:from-[#facc15] hover:to-[#f59e0b] hover:border-[#facc15] transition-all shadow-[0_3px_10px_rgba(0,0,0,0.5)]"
                      data-amount={amt}
                    >
                      ${amt.toLocaleString()}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            class="relative inline-block px-4 py-2 bg-gradient-to-r from-[#facc15] via-[#f59e0b] to-[#facc15] rounded-lg border-2 border-[#1E88E5] mb-4 shadow-[0_6px_20px_rgba(0,0,0,0.8)]"
          >
            <div class="flex items-center gap-2 relative z-10">
              <span class="text-2xl">🎁</span>
              <p class="text-white text-xs font-bold">
                ¡Juega y gana cupones exclusivos!
              </p>
            </div>
          </div>

          <button
            id="classic-continue-btn"
            class="w-full group relative overflow-hidden"
          >
            <div
              class="absolute -inset-1 bg-gradient-to-b from-[#1E88E5] via-[#facc15] to-[#1E88E5] rounded-xl blur opacity-75 group-hover:opacity-100 transition-opacity"
            >
            </div>
            <div
              class="relative bg-gradient-to-b from-[#1E88E5] via-[#1976D2] to-[#1565C0] py-3 px-4 rounded-xl font-black text-lg uppercase tracking-wide transition-all duration-300 group-hover:scale-[1.02] shadow-[0_6px_24px_rgba(0,0,0,0.9)] flex items-center justify-center gap-2 border-[3px] border-[#facc15] group-active:translate-y-1"
            >
              <span
                class="relative z-10 text-white drop-shadow-[2px_2px_4px_rgba(0,0,0,0.3)]"
                >🎰 CONTINUAR</span
              >
            </div>
          </button>
          <p class="text-[#1E88E5]/50 text-[10px] mt-3 text-center italic">
            El beneficio depende del monto de cambio ingresado.
          </p>
        </div>
      </div>

      <!-- ─── MACHINE VIEW ─── -->
      <div id="classic-machine-view" class="hidden w-full px-3 py-4">
        <div class="flex flex-col items-center text-center w-full">
          <div class="relative w-full max-w-md">
            <!-- HEADER -->
            <div
              class="relative bg-gradient-to-b from-[#1E88E5] via-[#1976D2] to-[#1565C0] rounded-t-2xl px-6 py-3 shadow-[0_6px_20px_rgba(0,0,0,0.8)] border-[3px] border-b-0 border-[#facc15]"
            >
              <div class="absolute -top-5 left-1/2 -translate-x-1/2">
                <div
                  class="text-4xl filter drop-shadow-[0_0_15px_rgba(30,136,229,1)]"
                >
                  ⭐
                </div>
              </div>
              <h3
                class="relative text-white font-black text-xl uppercase tracking-wider drop-shadow-[2px_2px_4px_rgba(0,0,0,0.5)] pt-1"
              >
                MARKET DOLLAR
              </h3>
            </div>

            <!-- CUERPO - MÁS COMPACTO -->
            <div
              class="relative bg-gradient-to-b from-[#0A2540] via-[#1565C0] to-[#0A2540] border-[3px] border-[#1E88E5] shadow-[0_25px_70px_rgba(0,0,0,0.9)] rounded-b-2xl overflow-hidden"
              id="classic-machine-body"
            >
              <!-- Luces superiores - MÁS PEQUEÑAS -->
              <div
                class="relative bg-gradient-to-b from-[#0A2540] via-[#1565C0] to-[#1565C0] p-3 border-b-[3px] border-[#1E88E5]"
              >
                <div class="flex justify-around">
                  <div
                    class="w-3 h-3 bg-[#1E88E5] rounded-full animate-pulse shadow-[0_0_12px_rgba(30,136,229,1)]"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_12px_rgba(250,204,21,1)]"
                    style="animation-delay:0.2s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#1E88E5] rounded-full animate-pulse shadow-[0_0_12px_rgba(30,136,229,1)]"
                    style="animation-delay:0.4s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_12px_rgba(250,204,21,1)]"
                    style="animation-delay:0.6s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#1E88E5] rounded-full animate-pulse shadow-[0_0_12px_rgba(30,136,229,1)]"
                    style="animation-delay:0.8s"
                  >
                  </div>
                </div>
              </div>

              <!-- CARRETES - ALTURA REDUCIDA a 250px -->
              <div
                class="relative bg-gradient-to-b from-[#0A2540] to-[#000000] p-4"
              >
                <div
                  class="absolute inset-4 border-[3px] border-[#1E88E5] rounded-lg pointer-events-none z-20 shadow-[inset_0_0_25px_rgba(30,136,229,0.2),0_0_25px_rgba(30,136,229,0.4)]"
                >
                </div>

                <div class="relative flex gap-2" id="classic-reels-wrapper">
                  <!-- REEL 1 -->
                  <div
                    class="flex-1 rounded-lg overflow-hidden border-[5px] border-[#0A2540] shadow-[0_6px_20px_rgba(0,0,0,0.9)] relative"
                    id="classic-reel-frame-1"
                    style="height:250px;"
                  >
                    <div
                      class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-white/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-black/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      id="classic-reel-1"
                      style="position:absolute;top:0;left:0;width:100%;will-change:transform;transform:translateY(-666.64px);"
                    >
                      {
                        EXTENDED.map((symbol, idx) => (
                          <div
                            style="height:83.33px;display:flex;align-items:center;justify-content:center;font-size:2.8rem;border-bottom:2px solid #e5e7eb;background:linear-gradient(to bottom,#fff,#f3f4f6);"
                            data-idx={idx}
                          >
                            {symbol}
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <!-- REEL 2 -->
                  <div
                    class="flex-1 rounded-lg overflow-hidden border-[5px] border-[#0A2540] shadow-[0_6px_20px_rgba(0,0,0,0.9)] relative"
                    id="classic-reel-frame-2"
                    style="height:250px;"
                  >
                    <div
                      class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-white/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-black/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      id="classic-reel-2"
                      style="position:absolute;top:0;left:0;width:100%;will-change:transform;transform:translateY(-833.3px);"
                    >
                      {
                        EXTENDED.map((symbol, idx) => (
                          <div
                            style="height:83.33px;display:flex;align-items:center;justify-content:center;font-size:2.8rem;border-bottom:2px solid #e5e7eb;background:linear-gradient(to bottom,#fff,#f3f4f6);"
                            data-idx={idx}
                          >
                            {symbol}
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <!-- REEL 3 -->
                  <div
                    class="flex-1 rounded-lg overflow-hidden border-[5px] border-[#0A2540] shadow-[0_6px_20px_rgba(0,0,0,0.9)] relative"
                    id="classic-reel-frame-3"
                    style="height:250px;"
                  >
                    <div
                      class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-white/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-black/40 to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                      id="classic-reel-3"
                      style="position:absolute;top:0;left:0;width:100%;will-change:transform;transform:translateY(-749.97px);"
                    >
                      {
                        EXTENDED.map((symbol, idx) => (
                          <div
                            style="height:83.33px;display:flex;align-items:center;justify-content:center;font-size:2.8rem;border-bottom:2px solid #e5e7eb;background:linear-gradient(to bottom,#fff,#f3f4f6);"
                            data-idx={idx}
                          >
                            {symbol}
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <!-- LÍNEA DE PAGO ajustada a nueva altura -->
                  <div
                    id="classic-payline"
                    class="absolute left-0 right-0 pointer-events-none z-30"
                    style="top:123px;height:4px;"
                  >
                    <div
                      style="width:100%;height:100%;background:linear-gradient(to right,transparent,#1E88E5 30%,#1E88E5 70%,transparent);box-shadow:0 0 15px rgba(30,136,229,0.9),0 0 35px rgba(30,136,229,0.4);"
                    >
                    </div>
                  </div>
                  <!-- Marcadores -->
                  <div
                    class="absolute left-0 z-30 pointer-events-none"
                    style="top:118px;"
                  >
                    <div
                      style="width:24px;height:24px;background:#1E88E5;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:11px;border:2px solid #facc15;box-shadow:0 0 12px rgba(30,136,229,0.9);"
                    >
                      ▶
                    </div>
                  </div>
                  <div
                    class="absolute right-0 z-30 pointer-events-none"
                    style="top:118px;"
                  >
                    <div
                      style="width:24px;height:24px;background:#1E88E5;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:11px;border:2px solid #facc15;box-shadow:0 0 12px rgba(30,136,229,0.9);"
                    >
                      ◀
                    </div>
                  </div>
                </div>
              </div>

              <!-- Luces inferiores + PALANCA -->
              <div
                class="relative bg-gradient-to-b from-[#1565C0] via-[#0A2540] to-[#0A2540] p-3 border-t-[3px] border-[#1E88E5]"
              >
                <div class="flex justify-around mb-2">
                  <div
                    class="w-3 h-3 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_12px_rgba(250,204,21,1)]"
                    style="animation-delay:0.1s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#1E88E5] rounded-full animate-pulse shadow-[0_0_12px_rgba(30,136,229,1)]"
                    style="animation-delay:0.3s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_12px_rgba(250,204,21,1)]"
                    style="animation-delay:0.5s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#1E88E5] rounded-full animate-pulse shadow-[0_0_12px_rgba(30,136,229,1)]"
                    style="animation-delay:0.7s"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-[#facc15] rounded-full animate-pulse shadow-[0_0_12px_rgba(250,204,21,1)]"
                    style="animation-delay:0.9s"
                  >
                  </div>
                </div>

                <!-- PALANCA - MÁS PEQUEÑA -->
                <div class="flex justify-center">
                  <button
                    id="classic-lever-btn"
                    class="lever-button relative group"
                    style="width:65px;height:100px;"
                  >
                    <div
                      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-10 h-5 bg-gradient-to-b from-[#1E88E5] to-[#1565C0] rounded-lg border-2 border-[#facc15] shadow-[0_3px_10px_rgba(0,0,0,0.8)]"
                    >
                    </div>
                    <div
                      class="lever-handle absolute left-1/2 w-2.5 bg-gradient-to-r from-[#1E88E5] via-[#1565C0] to-[#0A2540] rounded-full border-2 border-[#facc15]/50 shadow-[inset_-2px_0_4px_rgba(0,0,0,0.5)]"
                      style="bottom:20px;height:65px;transform:translateX(-50%);transform-origin:bottom center;transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1);"
                    >
                    </div>
                    <div
                      class="lever-ball absolute left-1/2 w-8 h-8 bg-gradient-to-br from-[#facc15] via-[#f59e0b] to-[#d97706] rounded-full border-[3px] border-[#1E88E5] shadow-[0_0_20px_rgba(250,204,21,0.8)] cursor-pointer group-hover:shadow-[0_0_30px_rgba(250,204,21,1)]"
                      style="top:0;transform:translateX(-50%);transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1);"
                    >
                    </div>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Status text -->
          <div
            class="mt-4 bg-gradient-to-r from-transparent via-[#1E88E5]/20 to-transparent p-2 rounded-lg"
          >
            <p
              class="text-[#1E88E5] text-sm font-bold animate-pulse"
              id="classic-status-text"
            >
              ¡Tira la palanca para comenzar!
            </p>
          </div>
        </div>
      </div>

      <!-- ─── RESULT VIEW ─── -->
      <div id="classic-result-view" class="hidden w-full px-4 py-4">
        <div
          class="flex flex-col items-center text-center w-full relative overflow-hidden"
        >
          <div class="relative z-10 w-full">
            <div
              class="relative bg-gradient-to-b from-[#1E88E5] via-[#1976D2] to-[#1565C0] rounded-xl p-3 mb-4 shadow-[0_6px_24px_rgba(0,0,0,0.8)] border-[3px] border-[#facc15]"
            >
              <h3
                class="relative text-white font-black text-xl uppercase tracking-wider drop-shadow-[2px_2px_4px_rgba(0,0,0,0.5)]"
              >
                🎉 ¡GANASTE! 🎉
              </h3>
            </div>

            <div class="flex justify-center gap-3 mb-4">
              <div
                class="text-5xl animate-bounce filter drop-shadow-[0_0_15px_rgba(30,136,229,0.8)]"
                id="classic-symbol-1"
              >
                🎁
              </div>
              <div
                class="text-5xl animate-bounce filter drop-shadow-[0_0_15px_rgba(30,136,229,0.8)]"
                id="classic-symbol-2"
                style="animation-delay:0.2s"
              >
                🎁
              </div>
              <div
                class="text-5xl animate-bounce filter drop-shadow-[0_0_15px_rgba(30,136,229,0.8)]"
                id="classic-symbol-3"
                style="animation-delay:0.4s"
              >
                🎁
              </div>
            </div>

            <div class="w-full mb-3 relative">
              <div
                class="relative bg-gradient-to-br from-[#0A2540] via-[#1565C0] to-[#0A2540] border-[3px] border-[#1E88E5] rounded-lg overflow-hidden shadow-[0_0_30px_rgba(30,136,229,0.5)]"
              >
                <div
                  class="relative p-4 bg-gradient-to-b from-white/5 to-transparent"
                >
                  <div class="flex items-center justify-center gap-2 mb-2">
                    <span
                      class="text-[9px] text-[#80c3ff] uppercase font-semibold tracking-widest"
                      >Tu código ganador</span
                    >
                  </div>
                  <div
                    id="classic-coupon-code"
                    class="text-[#84c6ff] font-mono text-xl font-black tracking-wide break-all mb-2 drop-shadow-[0_0_8px_rgba(30,136,229,1)]"
                  >
                    --
                  </div>
                  <div
                    class="relative h-[2px] bg-gradient-to-r from-transparent via-[#1E88E5] to-transparent mb-2"
                  >
                  </div>
                  <div
