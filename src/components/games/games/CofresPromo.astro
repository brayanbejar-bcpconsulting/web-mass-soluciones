<script define:vars={{ apiUrl, apiPlayUrl }}>
  (function () {
    "use strict";

    const COOLDOWN_TIME = 24 * 60 * 60 * 1000;
    const API_CONFIG_URL = apiUrl;
    const API_PLAY_URL = apiPlayUrl;
    const STORAGE_KEYS = {
      LAST_PLAY: "last_cups_play_timestamp",
      COUPON_CODE: "user_cups_coupon_code",
      COUPON_DATA: "user_cups_coupon_data",
      AUTH_TOKEN: "auth_token",
    };

    const elements = {
      loadingView: document.getElementById("loading-view"),
      errorView: document.getElementById("error-view"),
      noGameView: document.getElementById("no-game-view"),
      cupsView: document.getElementById("cups-view"),
      resultView: document.getElementById("result-view"),
      cupContainers: document.querySelectorAll(".cup-container"),
      cupsContainer: document.getElementById("cups-container"),
      retryBtn: document.getElementById("retry-btn"),
      couponCode: document.getElementById("coupon-code"),
      couponDescription: document.getElementById("coupon-description"),
      expirationDate: document.getElementById("expiration-date"),
      errorMessage: document.getElementById("error-message"),
      cooldownMessage: document.getElementById("cooldown-message"),
      cooldownTimer: document.getElementById("cooldown-timer"),
      savedCodeDisplay: document.getElementById("saved-code-display"),
      claimBtn: document.getElementById("claimBtn"),
      claimText: document.getElementById("claim-text"),
      container: document.querySelector("#promo-container"),
      card: document.querySelector("#promo-card"),
      backdrop: document.querySelector("#mobile-backdrop"),
      tab: document.querySelector("#cups-promo-tab"),
      closeBtn: document.querySelector("#close-btn"),
    };

    const appState = {
      currentGame: null,
      autoHideTimer: null,
      cooldownTimer: null,
      hasInteracted: false,
      isPlaying: false,
      isInitialized: false,
      hasShuffled: false,
    };

    function canUserPlay() {
      const lastPlay = localStorage.getItem(STORAGE_KEYS.LAST_PLAY);
      if (!lastPlay) return true;

      const now = Date.now();
      const diff = now - parseInt(lastPlay);
      return diff >= COOLDOWN_TIME;
    }

    function getTimeRemaining() {
      const lastPlay = localStorage.getItem(STORAGE_KEYS.LAST_PLAY);
      if (!lastPlay) return null;

      const diff = COOLDOWN_TIME - (Date.now() - parseInt(lastPlay));
      if (diff <= 0) return null;

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      return `${hours}h ${minutes}m`;
    }

    function updateCooldownDisplay() {
      const timeLeft = getTimeRemaining();
      if (timeLeft && elements.cooldownTimer) {
        elements.cooldownTimer.textContent = timeLeft;
      } else if (!timeLeft) {
        if (appState.cooldownTimer) {
          clearInterval(appState.cooldownTimer);
          appState.cooldownTimer = null;
        }
        fetchGameData();
      }
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      return date.toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    }

    async function fetchGameData() {
      try {
        showView("loading");

        const response = await fetch(API_CONFIG_URL);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();

        // Buscar el juego de tipo CUPS que esté activo
        const cupsGame = data.games?.find(
          (game) => game.game_type === "CUPS" && game.active === true,
        );

        if (!cupsGame) {
          showView("no-game");
          return;
        }

        // Guardar el juego actual
        appState.currentGame = cupsGame;

        checkCooldownStatus();
        showView("cups");

        if (!appState.hasShuffled) {
          setTimeout(() => {
            shuffleCups();
          }, 800);
        }
      } catch (error) {
        console.error("Error fetching game data:", error);
        if (elements.errorMessage) {
          elements.errorMessage.textContent =
            error.message || "Error al cargar el juego";
        }
        showView("error");
      }
    }

    function shuffleCups() {
      if (!elements.cupsContainer) return;

      appState.hasShuffled = true;
      elements.cupsContainer.classList.add("cup-shuffling");

      playSound("shuffle");

      setTimeout(() => {
        elements.cupsContainer.classList.remove("cup-shuffling");
      }, 3000);
    }

    function checkCooldownStatus() {
      if (!canUserPlay()) {
        if (elements.cupContainers) {
          elements.cupContainers.forEach((cup) => {
            cup.classList.add("cup-disabled");
          });
        }

        // Cargar y mostrar resultado guardado si existe
        const savedCouponCode = localStorage.getItem(STORAGE_KEYS.COUPON_CODE);
        const savedCouponData = localStorage.getItem(STORAGE_KEYS.COUPON_DATA);
        
        if (savedCouponCode && savedCouponData) {
          try {
            const prize = JSON.parse(savedCouponData);
            // Verificar si no ha expirado
            const expiresAt = new Date(prize.disponibilidad.fecha_expiracion);
            if (expiresAt > new Date()) {
              // Mostrar resultado guardado
              if (elements.couponCode) elements.couponCode.textContent = prize.codigo;
              if (elements.couponDescription) elements.couponDescription.textContent = prize.descripcion;
              if (elements.expirationDate) elements.expirationDate.textContent = formatDate(prize.disponibilidad.fecha_expiracion);
              showView("result");
            } else {
              // Limpiar resultado expirado
              localStorage.removeItem(STORAGE_KEYS.COUPON_CODE);
              localStorage.removeItem(STORAGE_KEYS.COUPON_DATA);
              // Mostrar mensaje de cooldown sin código
              if (elements.cooldownMessage) {
                elements.cooldownMessage.classList.remove("hidden");
                if (elements.savedCodeDisplay) elements.savedCodeDisplay.textContent = "Cupón expirado";
              }
              if (appState.cooldownTimer) clearInterval(appState.cooldownTimer);
              appState.cooldownTimer = setInterval(updateCooldownDisplay, 1000);
              updateCooldownDisplay();
            }
          } catch (e) {
            console.error('Error loading saved coupon:', e);
            // Error al cargar, mostrar mensaje de cooldown sin código
            if (elements.cooldownMessage) {
              elements.cooldownMessage.classList.remove("hidden");
              if (elements.savedCodeDisplay) elements.savedCodeDisplay.textContent = "Ya jugaste hoy";
            }
            if (appState.cooldownTimer) clearInterval(appState.cooldownTimer);
            appState.cooldownTimer = setInterval(updateCooldownDisplay, 1000);
            updateCooldownDisplay();
          }
        } else {
          // No hay cupón guardado, mostrar mensaje de cooldown sin código
          if (elements.cooldownMessage) {
            elements.cooldownMessage.classList.remove("hidden");
            if (elements.savedCodeDisplay) elements.savedCodeDisplay.textContent = "Ya jugaste hoy";
          }
          if (appState.cooldownTimer) clearInterval(appState.cooldownTimer);
          appState.cooldownTimer = setInterval(updateCooldownDisplay, 1000);
          updateCooldownDisplay();
        }
      } else {
        if (elements.cupContainers) {
          elements.cupContainers.forEach((cup) => {
            cup.classList.remove("cup-disabled");
          });
        }
        if (elements.cooldownMessage) elements.cooldownMessage.classList.add("hidden");
      }
    }

    function showView(viewName) {
      const views = [
        elements.loadingView,
        elements.errorView,
        elements.noGameView,
        elements.cupsView,
        elements.resultView,
      ];

      views.forEach((view) => {
        if (view) {
          view.classList.add("hidden");
          view.style.display = "none";
        }
      });

      let targetView = null;
      switch (viewName) {
        case "loading":
          targetView = elements.loadingView;
          break;
        case "error":
          targetView = elements.errorView;
          break;
        case "no-game":
          targetView = elements.noGameView;
          break;
        case "cups":
          targetView = elements.cupsView;
          break;
        case "result":
          targetView = elements.resultView;
          break;
      }

      if (targetView) {
        targetView.classList.remove("hidden");
        targetView.style.display = "block";
      }
    }

    function openPromo() {
      if (appState.autoHideTimer) {
        clearTimeout(appState.autoHideTimer);
        appState.autoHideTimer = null;
      }

      if (window.innerWidth < 768) {
        if (elements.container) elements.container.classList.add("mobile-popup-active");
        if (elements.backdrop) elements.backdrop.classList.add("backdrop-active");
      } else {
        if (elements.card) elements.card.classList.add("state-open-card");
      }
      if (elements.tab) elements.tab.classList.add("state-hide-tab");
    }

    function closePromo() {
      if (elements.container) elements.container.classList.remove("mobile-popup-active");
      if (elements.backdrop) elements.backdrop.classList.remove("backdrop-active");
      if (elements.card) elements.card.classList.remove("state-open-card");
      if (elements.tab) elements.tab.classList.remove("state-hide-tab");
    }

    function playSound(type) {
      const sounds = {
        select:
          "https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3",
        win: "https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3",
        shuffle:
          "https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3",
      };

      if (sounds[type]) {
        const audio = new Audio(sounds[type]);
        audio.volume = 0.3;
        audio.play().catch(() => {});
      }
    }

    async function playCupsGame(cupId) {
      if (!canUserPlay() || appState.isPlaying || !appState.currentGame) return;

      appState.hasInteracted = true;
      appState.isPlaying = true;

      if (appState.autoHideTimer) {
        clearTimeout(appState.autoHideTimer);
        appState.autoHideTimer = null;
      }

      elements.cupContainers.forEach((cup) => {
        cup.classList.add("cup-disabled");
      });

      const selectedCup = document.querySelector(`[data-cup-id="${cupId}"]`);
      if (selectedCup) {
        selectedCup.classList.add("cup-selected");
        playSound("select");
      }

      await new Promise((resolve) => setTimeout(resolve, 1000));

      try {
        // Llamar a la API para jugar
        const playResponse = await fetch(API_PLAY_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            gameId: appState.currentGame.id,
          }),
        });

        const result = await playResponse.json();
        
        // Handle rate limited response
        if (result.error === "rate_limited") {
          const nextPlayAt = new Date(result.cooldown?.next_play_at);
          localStorage.setItem(STORAGE_KEYS.LAST_PLAY, (nextPlayAt.getTime() - COOLDOWN_TIME).toString());
          
          // Mostrar mensaje al usuario
          if (elements.savedCodeDisplay) {
            elements.savedCodeDisplay.textContent = "Ya jugaste hoy";
          }
          if (elements.cooldownMessage) {
            elements.cooldownMessage.classList.remove("hidden");
          }
          
          // Actualizar el timer de cooldown
          if (appState.cooldownTimer) clearInterval(appState.cooldownTimer);
          appState.cooldownTimer = setInterval(updateCooldownDisplay, 1000);
          updateCooldownDisplay();
          
          checkCooldownStatus();
          appState.isPlaying = false;
          
          if (elements.cupContainers) {
            elements.cupContainers.forEach((cup) => {
              cup.classList.remove("cup-selected");
              cup.classList.add("cup-disabled");
            });
          }
          
          // Notificación visual
          const nextPlayDate = new Date(result.cooldown?.next_play_at);
          const timeStr = nextPlayDate.toLocaleString("es-PE", { 
            dateStyle: "short", 
            timeStyle: "short" 
          });
          
          return;
        }

        if (!playResponse.ok) {
          throw new Error(`Error al jugar: ${playResponse.status}`);
        }

        // El servidor devuelve el premio ganado
        // Estructura: { success, result: { won, tier_label, visual_symbols }, claim: { token, expires_at, claim_url } }

        let prize = {
          codigo: result.claim?.token || `CUPS-${Date.now()}`,
          descripcion: `Cupón ganador - Tier: ${result.result?.tier_label || 'especial'}`,
          disponibilidad: {
            fecha_expiracion:
              result.claim?.expires_at ||
              new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
          },
        };

        // Guardar timestamp de último juego
        localStorage.setItem(STORAGE_KEYS.LAST_PLAY, Date.now().toString());

        showWinningResult(prize);
      } catch (error) {
        console.error("Error playing game:", error);
        if (typeof alert !== 'undefined') {
          alert("Hubo un error al jugar. Por favor, intenta de nuevo.");
        }
        appState.isPlaying = false;
        if (elements.cupContainers) {
          elements.cupContainers.forEach((cup) => {
            cup.classList.remove("cup-disabled", "cup-selected");
          });
        }
      }
    }

    function showWinningResult(prize) {
      localStorage.setItem(STORAGE_KEYS.COUPON_CODE, prize.codigo);
      localStorage.setItem(STORAGE_KEYS.COUPON_DATA, JSON.stringify(prize));

      if (elements.couponCode) elements.couponCode.textContent = prize.codigo;
      if (elements.couponDescription) elements.couponDescription.textContent = prize.descripcion;
      if (elements.expirationDate) {
        elements.expirationDate.textContent = formatDate(
          prize.disponibilidad.fecha_expiracion,
        );
      }

      showView("result");
      playSound("win");

      if (typeof confetti === "function") {
        const duration = 3000;
        const end = Date.now() + duration;

        const frame = () => {
          confetti({
            particleCount: 3,
            angle: 60,
            spread: 55,
            origin: { x: 0, y: 0.6 },
            colors: ["#FFC107", "#FFD54F", "#FFB300"],
          });
          confetti({
            particleCount: 3,
            angle: 120,
            spread: 55,
            origin: { x: 1, y: 0.6 },
            colors: ["#FFC107", "#FFD54F", "#FFB300"],
          });

          if (Date.now() < end) {
            requestAnimationFrame(frame);
          }
        };

        frame();
      }

      appState.isPlaying = false;
    }

    function setupEventListeners() {
      if (appState.isInitialized) return;

      if (elements.container) {
        elements.container.addEventListener("mouseenter", () => {
          if (!appState.isPlaying) {
            openPromo();
            appState.hasInteracted = true;
          }
        });

        elements.container.addEventListener("mouseleave", () => {
          if (!appState.isPlaying && !appState.hasInteracted) {
            appState.autoHideTimer = setTimeout(closePromo, 5000);
          }
        });
      }

      if (elements.tab) {
        elements.tab.addEventListener("click", (e) => {
          e.stopPropagation();
          appState.hasInteracted = true;
          openPromo();
        });
      }

      if (elements.closeBtn) {
        elements.closeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          appState.hasInteracted = true;
          closePromo();
        });
      }

      if (elements.cupContainers) {
        elements.cupContainers.forEach((cupContainer) => {
          cupContainer.addEventListener("click", () => {
            const cupId = parseInt(cupContainer.dataset.cupId);
            playCupsGame(cupId);
          });
        });
      }

      if (elements.retryBtn) {
        elements.retryBtn.addEventListener("click", fetchGameData);
      }

      if (elements.claimBtn) {
        elements.claimBtn.addEventListener("click", () => {
        const code = elements.couponCode.innerText;
        navigator.clipboard.writeText(code).then(() => {
          elements.claimText.innerText = "¡Copiado!";
          elements.claimBtn.style.background =
            "linear-gradient(to right, #10b981, #059669)";

          setTimeout(() => {
            const isLoggedIn =
              localStorage.getItem(STORAGE_KEYS.AUTH_TOKEN) !== null;
            if (isLoggedIn) {
              window.location.href = "https://app.market-dollar.com/dashboard";
            } else {
              window.location.href = "https://app.market-dollar.com/register";
            }
          }, 1000);
        });
      });

      appState.isInitialized = true;
    }}

    function initAutoShow() {
      setTimeout(() => {
        const isDesktop = window.innerWidth >= 768;
        if (!appState.hasInteracted && isDesktop) {
          openPromo();
          appState.autoHideTimer = setTimeout(() => {
            if (!appState.hasInteracted && !appState.isPlaying) {
              closePromo();
            }
          }, 8000);
        }
      }, 2000);
    }

    function cleanup() {
      if (appState.autoHideTimer) clearTimeout(appState.autoHideTimer);
      if (appState.cooldownTimer) clearInterval(appState.cooldownTimer);
    }

    window.addEventListener("beforeunload", cleanup);

    function init() {
      setupEventListeners();
      fetchGameData();
      initAutoShow();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    } }
  
  )();
</script>
