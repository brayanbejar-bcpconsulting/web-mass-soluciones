---
// LuckyCups.astro - Market Dollar Edition (API Real)
const API_BASE = import.meta.env.MARKET_DOLLAR_API_URL || "https://app.market-dollar.com";
const { 
  apiUrl = `${API_BASE}/api/v1/games/config`,
  apiPlayUrl = `${API_BASE}/api/v1/games/play-guest`,
} = Astro.props;
---

<script
  src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"
></script>

<!-- Backdrop -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/80 z-[40] hidden opacity-0 transition-opacity duration-300 md:hidden backdrop-blur-md"
  aria-hidden="true"
>
</div>

<!-- Contenedor principal -->
<div
  class="fixed left-0 z-[50] flex items-center font-sans transition-all duration-300
          bottom-4 scale-[0.85] origin-bottom-left
          md:top-1/2 md:bottom-auto md:scale-100 md:-translate-y-1/2"
  id="promo-container"
>
  <!-- Tab lateral - Colores exactos de la ruleta -->
  <div
    id="cups-promo-tab"
    class="relative overflow-hidden bg-gradient-to-br from-[#003d82] via-[#002855] to-[#001d3d] h-56 w-14 rounded-r-3xl flex flex-col items-center justify-center cursor-pointer shadow-[0_0_40px_rgba(0,61,130,0.8),0_8px_32px_rgba(255,193,7,0.3)] transition-all duration-500 border-r-4 border-y-4 border-[#FFC107] z-20 hover:w-20 hover:shadow-[0_0_60px_rgba(0,61,130,1),0_12px_40px_rgba(255,193,7,0.5)] active:scale-95 group"
  >
    <!-- Líneas animadas doradas -->
    <div class="absolute inset-0 opacity-20">
      <div
        class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#FFC107] to-transparent animate-scan"
      >
      </div>
      <div
        class="absolute top-1/3 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#FFD54F] to-transparent animate-scan-delay"
      >
      </div>
      <div
        class="absolute top-2/3 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#FFC107] to-transparent animate-scan-delay-2"
      >
      </div>
    </div>

    <!-- Glow effect -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#FFC107]/15 via-[#002855]/20 to-[#FFC107]/10 animate-pulse-slow"
    >
    </div>

    <!-- Icono -->
    <div class="relative mb-4">
      <div
        class="absolute inset-0 blur-xl bg-gradient-to-br from-[#FFC107] to-[#FFB300] animate-pulse opacity-60"
      >
      </div>
      <span
        class="relative text-5xl animate-float filter drop-shadow-[0_0_10px_rgba(255,193,7,1)]"
        >📦</span
      >
    </div>

    <span
      class="uppercase font-black text-[11px] text-[#FFC107] [writing-mode:vertical-lr] tracking-[0.5em] drop-shadow-[0_0_10px_rgba(255,193,7,0.8)] transform rotate-180 group-hover:text-[#FFD54F] transition-colors"
    >
      SUERTE
    </span>

    <!-- Corner accent -->
    <div
      class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#FFD54F] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#FFC107] animate-pulse"
    >
    </div>
  </div>

  <!-- Card principal -->
  <div
    id="promo-card"
    class="absolute left-0 flex flex-col bg-gradient-to-br from-[#003d82] via-[#002855] to-[#001d3d] rounded-r-3xl shadow-[50px_20px_120px_rgba(0,0,0,0.9),0_0_100px_rgba(0,61,130,0.4)]
            w-[280px] md:w-[360px]
            translate-x-[-110%] opacity-0 transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]
            border-l-0 z-10 pointer-events-none overflow-hidden backdrop-blur-2xl border-2 border-[#FFC107]/60"
  >
    <!-- Grid pattern -->
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: repeating-linear-gradient(0deg, rgba(255,193,7,0.5) 0px, transparent 1px, transparent 20px), repeating-linear-gradient(90deg, rgba(255,193,7,0.5) 0px, transparent 1px, transparent 20px);"
    >
    </div>

    <!-- Gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#FFC107]/10 via-[#002855]/20 to-[#FFC107]/10 animate-gradient-rotate opacity-50"
    >
    </div>

    <!-- Close button -->
    <button
      id="close-btn"
      class="absolute top-4 right-4 z-30 bg-gradient-to-br from-red-600/20 to-red-700/20 hover:from-red-500/40 hover:to-red-600/40 text-red-300 rounded-lg w-10 h-10 flex items-center justify-center text-sm font-bold transition-all duration-300 cursor-pointer shadow-[0_0_20px_rgba(239,68,68,0.3)] backdrop-blur-sm border border-red-500/30 hover:scale-110 hover:border-red-400 group"
    >
      <span class="group-hover:rotate-90 transition-transform duration-300"
        >✕</span
      >
    </button>

    <div
      class="bg-gradient-to-br from-[#003d82]/50 via-[#002855]/30 to-[#001d3d]/50 backdrop-blur-xl rounded-r-[20px] w-full border border-[#FFC107]/20 overflow-y-auto overflow-x-hidden relative z-10"
      style="min-height: 450px; max-height: 85vh;"
    >
      <!-- Loading State -->
      <div
        id="loading-view"
        class="flex flex-col items-center justify-center w-full px-4 py-8"
        style="min-height: 400px;"
      >
        <div class="relative">
          <div
            class="animate-spin rounded-full h-16 w-16 border-4 border-[#002855]/30 border-t-[#FFC107]"
          >
          </div>
          <div
            class="absolute inset-0 animate-ping rounded-full border-4 border-[#FFC107]/20"
          >
          </div>
        </div>
        <p class="text-[#FFC107] mt-4 text-sm font-semibold animate-pulse">
          Cargando...
        </p>
      </div>

      <!-- Error State -->
      <div
        id="error-view"
        class="hidden flex-col items-center justify-center w-full px-4 py-8"
        style="min-height: 400px;"
      >
        <div class="text-5xl mb-4 animate-bounce">⚠️</div>
        <p class="text-red-400 font-bold text-lg mb-2">Error al cargar</p>
        <p class="text-[#FFC107]/70 text-sm mb-6" id="error-message">
          No se pudo cargar el juego
        </p>
        <button
          id="retry-btn"
          class="bg-gradient-to-r from-[#FFC107] to-[#FFB300] text-[#002855] px-8 py-3 rounded-xl font-bold hover:from-[#FFD54F] hover:to-[#FFC107] transition-all shadow-[0_0_20px_rgba(255,193,7,0.5)] hover:shadow-[0_0_30px_rgba(255,193,7,0.8)] border border-[#002855]/20 uppercase tracking-wider"
        >
          Reintentar
        </button>
      </div>

      <!-- No Game Available -->
      <div
        id="no-game-view"
        class="hidden flex-col items-center justify-center w-full px-4 py-8"
        style="min-height: 400px;"
      >
        <div class="text-5xl mb-4">🔒</div>
        <p class="text-[#FFC107] font-bold text-lg mb-2">
          Sin juegos disponibles
        </p>
        <p class="text-[#FFC107]/70 text-sm">
          Vuelve pronto para nuevas promociones
        </p>
      </div>

      <!-- Cups Game View -->
      <div id="cups-view" class="hidden w-full px-4 py-6">
        <div class="flex flex-col items-center text-center w-full">
          <!-- Header -->
          <div class="relative mb-6 w-full">
            <div
              class="absolute inset-0 bg-gradient-to-r from-transparent via-[#FFC107]/20 to-transparent blur-2xl"
            >
            </div>

            <!-- Título -->
            <div class="relative mb-3">
              <h3
                class="text-[#FFC107] font-black text-2xl uppercase tracking-wider drop-shadow-[0_0_20px_rgba(255,193,7,0.8)]"
              >
                ¡ELIGE TU COFRE!
              </h3>
              <div
                class="absolute -inset-2 bg-gradient-to-r from-[#FFC107]/20 via-[#FFD54F]/20 to-[#FFC107]/20 blur-2xl -z-10 animate-pulse-slow"
              >
              </div>
            </div>

            <!-- Subtitle -->
            <div class="flex items-center justify-center gap-2 mb-3">
              <div
                class="h-[1px] w-10 bg-gradient-to-r from-transparent to-[#FFC107]"
              >
              </div>
              <p
                class="text-white text-xs font-semibold uppercase tracking-widest"
              >
                Y descubre tu premio
              </p>
              <div
                class="h-[1px] w-10 bg-gradient-to-l from-transparent to-[#FFC107]"
              >
              </div>
            </div>

            <!-- Premio info -->
            <div
              class="relative inline-block px-5 py-2 bg-gradient-to-r from-[#004a99]/60 via-[#003d82]/60 to-[#004a99]/60 rounded-xl border border-[#FFC107]/30 backdrop-blur-sm"
            >
              <div
                class="absolute inset-0 bg-gradient-to-r from-[#FFC107]/10 via-[#FFD54F]/10 to-[#FFC107]/10 animate-pulse-slow rounded-xl"
              >
              </div>
              <p class="text-white text-xs font-semibold relative z-10">
                <span class="text-[#FFC107] font-bold">¡Gana cupones exclusivos!</span>
              </p>
            </div>
          </div>

          <!-- Mesa de juego -->
          <div class="relative w-full mb-6">
            <!-- Superficie -->
            <div
              class="relative bg-gradient-to-br from-[#003d82]/80 via-[#002855]/90 to-[#001d3d]/80 rounded-2xl p-6 border-2 border-[#FFC107]/40 shadow-[0_20px_60px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(255,193,7,0.2)] backdrop-blur-sm"
            >
              <!-- Grid -->
              <div
                class="absolute inset-0 opacity-10 rounded-3xl overflow-hidden"
              >
                <div
                  class="absolute inset-0"
                  style="background-image: repeating-linear-gradient(0deg, rgba(255,193,7,0.3) 0px, transparent 1px, transparent 30px), repeating-linear-gradient(90deg, rgba(255,193,7,0.3) 0px, transparent 1px, transparent 30px);"
                >
                </div>
              </div>

              <!-- Spotlight -->
              <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-48 h-48 bg-gradient-radial from-[#FFC107]/20 to-transparent blur-2xl"
              >
              </div>

              <!-- Vasitos Container - Ahora son COFRES DEL TESORO -->
              <div
                id="cups-container"
                class="flex justify-center gap-6 relative z-10"
              >
                <!-- Cofre 1 -->
                <div class="cup-container" data-cup-id="1" data-position="0">
                  <div class="cup-wrapper relative cursor-pointer group">
                    <!-- Glow externo -->
                    <div
                      class="absolute -inset-4 bg-gradient-to-b from-[#FFC107]/0 via-[#FFC107]/40 to-[#FFB300]/0 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-all duration-500"
                    >
                    </div>

                    <div class="relative">
                      <div
                        class="cup-3d relative w-24 h-24 transition-all duration-500 group-hover:scale-110 group-hover:-translate-y-4"
                      >
                        <!-- Cofre del tesoro -->
                        <div class="absolute inset-0 perspective-1000">
                          <!-- Base del cofre -->
                          <div
                            class="absolute inset-0 bg-gradient-to-b from-[#8B4513] via-[#654321] to-[#3E2723] rounded-lg shadow-[0_15px_40px_rgba(139,69,19,0.6),inset_0_-2px_10px_rgba(0,0,0,0.5)] border-2 border-[#5D4037]/50"
                          >
                            <!-- Textura de madera -->
                            <div class="absolute inset-0 opacity-20">
                              <div
                                class="absolute inset-0"
                                style="background: repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(0,0,0,0.1) 10px, rgba(0,0,0,0.1) 11px);"
                              >
                              </div>
                            </div>
                          </div>

                          <!-- Tapa dorada del cofre -->
                          <div
                            class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-[#FFC107] via-[#FFB300] to-[#FF8F00] rounded-t-lg shadow-[0_5px_15px_rgba(255,193,7,0.6),inset_0_1px_0_rgba(255,255,255,0.4)] border-2 border-[#FFD54F]/60 group-hover:animate-treasure-open"
                          >
                            <!-- Brillo en la tapa -->
                            <div
                              class="absolute inset-0 bg-gradient-to-br from-white/50 via-transparent to-transparent rounded-t-lg opacity-60"
                            >
                            </div>

                            <!-- Cerradura central -->
                            <div
                              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-5 bg-gradient-to-b from-[#FFD700] to-[#FFA000] rounded-sm shadow-[0_2px_8px_rgba(0,0,0,0.4)] border border-[#FFE082]"
                            >
                              <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-2 bg-[#3E2723] rounded-full"
                              >
                              </div>
                            </div>

                            <!-- Detalles metálicos -->
                            <div
                              class="absolute top-2 left-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                            <div
                              class="absolute top-2 right-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                          </div>

                          <!-- Bisagras laterales -->
                          <div
                            class="absolute top-10 left-0 w-2 h-3 bg-gradient-to-r from-[#8B7355] to-[#6F5A4A] rounded-r"
                          >
                          </div>
                          <div
                            class="absolute top-10 right-0 w-2 h-3 bg-gradient-to-l from-[#8B7355] to-[#6F5A4A] rounded-l"
                          >
                          </div>

                          <!-- Decoración frontal dorada -->
                          <div
                            class="absolute bottom-2 left-1/2 -translate-x-1/2 w-12 h-1 bg-gradient-to-r from-transparent via-[#FFC107] to-transparent shadow-[0_0_8px_rgba(255,193,7,0.6)]"
                          >
                          </div>

                          <!-- Brillos mágicos -->
                          <div
                            class="sparkle-1 absolute top-1 right-2 w-1 h-1 bg-[#FFD700] rounded-full animate-sparkle shadow-[0_0_6px_rgba(255,215,0,1)]"
                          >
                          </div>
                          <div
                            class="sparkle-2 absolute bottom-2 left-2 w-1 h-1 bg-[#FFC107] rounded-full animate-sparkle-delay shadow-[0_0_6px_rgba(255,193,7,1)]"
                          >
                          </div>
                        </div>

                        <!-- Sombra del cofre -->
                        <div
                          class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-20 h-3 bg-black/50 rounded-full blur-md"
                        >
                        </div>
                      </div>
                    </div>

                    <!-- Label -->
                    <div
                      class="mt-4 text-[#FFC107] text-sm font-bold group-hover:text-[#FFD54F] transition-colors uppercase tracking-wider"
                    >
                      <span
                        class="inline-block group-hover:scale-110 transition-transform drop-shadow-[0_0_5px_rgba(255,193,7,0.5)]"
                        >Cofre 1</span
                      >
                    </div>
                  </div>
                </div>

                <!-- Cofre 2 -->
                <div class="cup-container" data-cup-id="2" data-position="1">
                  <div class="cup-wrapper relative cursor-pointer group">
                    <div
                      class="absolute -inset-4 bg-gradient-to-b from-[#FFC107]/0 via-[#FFC107]/40 to-[#FFB300]/0 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-all duration-500"
                    >
                    </div>

                    <div class="relative">
                      <div
                        class="cup-3d relative w-24 h-24 transition-all duration-500 group-hover:scale-110 group-hover:-translate-y-4"
                      >
                        <div class="absolute inset-0 perspective-1000">
                          <div
                            class="absolute inset-0 bg-gradient-to-b from-[#8B4513] via-[#654321] to-[#3E2723] rounded-lg shadow-[0_15px_40px_rgba(139,69,19,0.6),inset_0_-2px_10px_rgba(0,0,0,0.5)] border-2 border-[#5D4037]/50"
                          >
                            <div class="absolute inset-0 opacity-20">
                              <div
                                class="absolute inset-0"
                                style="background: repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(0,0,0,0.1) 10px, rgba(0,0,0,0.1) 11px);"
                              >
                              </div>
                            </div>
                          </div>

                          <div
                            class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-[#FFC107] via-[#FFB300] to-[#FF8F00] rounded-t-lg shadow-[0_5px_15px_rgba(255,193,7,0.6),inset_0_1px_0_rgba(255,255,255,0.4)] border-2 border-[#FFD54F]/60 group-hover:animate-treasure-open"
                          >
                            <div
                              class="absolute inset-0 bg-gradient-to-br from-white/50 via-transparent to-transparent rounded-t-lg opacity-60"
                            >
                            </div>

                            <div
                              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-5 bg-gradient-to-b from-[#FFD700] to-[#FFA000] rounded-sm shadow-[0_2px_8px_rgba(0,0,0,0.4)] border border-[#FFE082]"
                            >
                              <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-2 bg-[#3E2723] rounded-full"
                              >
                              </div>
                            </div>

                            <div
                              class="absolute top-2 left-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                            <div
                              class="absolute top-2 right-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                          </div>

                          <div
                            class="absolute top-10 left-0 w-2 h-3 bg-gradient-to-r from-[#8B7355] to-[#6F5A4A] rounded-r"
                          >
                          </div>
                          <div
                            class="absolute top-10 right-0 w-2 h-3 bg-gradient-to-l from-[#8B7355] to-[#6F5A4A] rounded-l"
                          >
                          </div>

                          <div
                            class="absolute bottom-2 left-1/2 -translate-x-1/2 w-12 h-1 bg-gradient-to-r from-transparent via-[#FFC107] to-transparent shadow-[0_0_8px_rgba(255,193,7,0.6)]"
                          >
                          </div>

                          <div
                            class="sparkle-1 absolute top-1 right-2 w-1 h-1 bg-[#FFD700] rounded-full animate-sparkle shadow-[0_0_6px_rgba(255,215,0,1)]"
                          >
                          </div>
                          <div
                            class="sparkle-2 absolute bottom-2 left-2 w-1 h-1 bg-[#FFC107] rounded-full animate-sparkle-delay shadow-[0_0_6px_rgba(255,193,7,1)]"
                          >
                          </div>
                        </div>

                        <div
                          class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-20 h-3 bg-black/50 rounded-full blur-md"
                        >
                        </div>
                      </div>
                    </div>

                    <div
                      class="mt-4 text-[#FFC107] text-sm font-bold group-hover:text-[#FFD54F] transition-colors uppercase tracking-wider"
                    >
                      <span
                        class="inline-block group-hover:scale-110 transition-transform drop-shadow-[0_0_5px_rgba(255,193,7,0.5)]"
                        >Cofre 2</span
                      >
                    </div>
                  </div>
                </div>

                <!-- Cofre 3 -->
                <div class="cup-container" data-cup-id="3" data-position="2">
                  <div class="cup-wrapper relative cursor-pointer group">
                    <div
                      class="absolute -inset-4 bg-gradient-to-b from-[#FFC107]/0 via-[#FFC107]/40 to-[#FFB300]/0 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-all duration-500"
                    >
                    </div>

                    <div class="relative">
                      <div
                        class="cup-3d relative w-24 h-24 transition-all duration-500 group-hover:scale-110 group-hover:-translate-y-4"
                      >
                        <div class="absolute inset-0 perspective-1000">
                          <div
                            class="absolute inset-0 bg-gradient-to-b from-[#8B4513] via-[#654321] to-[#3E2723] rounded-lg shadow-[0_15px_40px_rgba(139,69,19,0.6),inset_0_-2px_10px_rgba(0,0,0,0.5)] border-2 border-[#5D4037]/50"
                          >
                            <div class="absolute inset-0 opacity-20">
                              <div
                                class="absolute inset-0"
                                style="background: repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(0,0,0,0.1) 10px, rgba(0,0,0,0.1) 11px);"
                              >
                              </div>
                            </div>
                          </div>

                          <div
                            class="absolute top-0 left-0 right-0 h-12 bg-gradient-to-b from-[#FFC107] via-[#FFB300] to-[#FF8F00] rounded-t-lg shadow-[0_5px_15px_rgba(255,193,7,0.6),inset_0_1px_0_rgba(255,255,255,0.4)] border-2 border-[#FFD54F]/60 group-hover:animate-treasure-open"
                          >
                            <div
                              class="absolute inset-0 bg-gradient-to-br from-white/50 via-transparent to-transparent rounded-t-lg opacity-60"
                            >
                            </div>

                            <div
                              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-5 bg-gradient-to-b from-[#FFD700] to-[#FFA000] rounded-sm shadow-[0_2px_8px_rgba(0,0,0,0.4)] border border-[#FFE082]"
                            >
                              <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-2 bg-[#3E2723] rounded-full"
                              >
                              </div>
                            </div>

                            <div
                              class="absolute top-2 left-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                            <div
                              class="absolute top-2 right-2 w-1 h-1 bg-[#FFD700] rounded-full shadow-[0_0_4px_rgba(255,215,0,1)]"
                            >
                            </div>
                          </div>

                          <div
                            class="absolute top-10 left-0 w-2 h-3 bg-gradient-to-r from-[#8B7355] to-[#6F5A4A] rounded-r"
                          >
                          </div>
                          <div
                            class="absolute top-10 right-0 w-2 h-3 bg-gradient-to-l from-[#8B7355] to-[#6F5A4A] rounded-l"
                          >
                          </div>

                          <div
                            class="absolute bottom-2 left-1/2 -translate-x-1/2 w-12 h-1 bg-gradient-to-r from-transparent via-[#FFC107] to-transparent shadow-[0_0_8px_rgba(255,193,7,0.6)]"
                          >
                          </div>

                          <div
                            class="sparkle-1 absolute top-1 right-2 w-1 h-1 bg-[#FFD700] rounded-full animate-sparkle shadow-[0_0_6px_rgba(255,215,0,1)]"
                          >
