---
import { APP_URLS } from "@/utils/navigation";
import Calculadora from "@components/Calculadora.astro";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";

// Image
import logoSBSWhite from '@assets/shared/logo-sbs-white.webp'
import { Image } from "astro:assets";

const btnHero = [
  {
    variant: 'outline',
    text: 'Regístrate Ahora',
    icon: 'user',
    href: `${APP_URLS.register}`
  },
  {
    variant: 'whatsapp',
    text: 'Obtén una mejor tasa',
    icon: 'whatsapp',
    href: `${APP_URLS.whatsappContact}`
  }
] as const;

const badgesHero = [
  {
    icon: 'shield-check',
    text: 'Operaciones 100% bancarizadas'
  },
  {
    icon: 'piggy-bank',
    text: 'Ahorra en cada cambio realizado'
  },
] as const;
---

<section class="w-full">
  <div class="mx-auto max-w-7xl flex flex-col lg:flex-row gap-8 bg-primary-800 px-[5%] lg:px-12 py-16 rounded-b-4xl">
    <header class="flex flex-col items-center lg:items-start gap-6 text-center lg:text-left">
      <span class="text-[10px] lg:text-xs text-primary-950 bg-white px-5 py-2 rounded-full font-bold uppercase tracking-widest">
        Bajo supervisión de la SBS y UIF
      </span>

      <h1 id="hero-empresas" class="text-3xl lg:text-5xl font-semibold text-white tracking-tight">
        Tipo de cambio corporativo en Perú: <br/>
        <span class="relative inline-block mt-2">
          <span class="text-secondary-300">
            Optimiza la rentabilidad
          </span>
        </span> 
        de tu empresa
      </h1>

      <p class="hidden md:inline-block text-base text-blue-100/80 max-w-xl leading-relaxed">
        Cambia dólares y soles con la tasa más competitiva del mercado. Obtén <strong>factura inmediata, atención personalizada y seguridad bancaria</strong>.
      </p>

      <nav class="flex flex-col md:flex-row gap-4">
        {
          btnHero.map((btn) => (
            <Button variant={btn.variant} href={btn.href} class="flex gap-2">
              <Icon name={btn.icon}/>
              {btn.text}
            </Button>
          ))
        }
      </nav>

      <div class="flex flex-col gap-4">
        {
          badgesHero.map((badge) => (
            <span class="flex gap-4 text-neutral-300 text-sm">
              <Icon name={badge.icon} class="text-secondary-200"/>
              {badge.text}
            </span>
          ))
        }
      </div>
    </header>

    <article class="flex flex-col gap-6">
      <div class="bg-neutral-50 p-6 rounded-2xl shadow-xl shadow-neutral-200/50">
        <Calculadora />
      </div>
      <div class="flex gap-4 items-center">
        <p class="text-neutral-50 text-sm">
          Estamos registrados ante la SBS:
        </p>
        <Image
          src={logoSBSWhite}
          alt="Logo de la entidad SBS Perú"
          class="w-50"
        />
      </div>
    </article>
  </div>

  <div class="mx-auto max-w-7xl flex items-center justify-center ">
    <a href="#section-beneficios" class="size-fit bg-white rounded-full -mt-5 animate-bounce">
      <Icon name="arrow-down" class="size-15 text-secondary-400"/>
    </a>
  </div>
</section>
