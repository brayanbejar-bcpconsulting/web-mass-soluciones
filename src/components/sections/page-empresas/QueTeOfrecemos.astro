---
import { Image } from "astro:assets";
import ContainerSection from "@components/ui/ContainerSection.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Carousel from "@components/ui/Carousel.astro";
import { parseSimpleMarkdown } from "@/utils/markdown";

// Iconos
import iconFactura from "@assets/icons/icon-factura.webp";
import iconAhorro from "@assets/icons/icon-ahorro.webp";
import iconSeguridad from "@assets/icons/icon-seguridad.webp";
import iconSoporte from "@assets/icons/icon-soporte.webp";

const cardsBeneficios = [
  {
    title: "Tipo de cambio preferencial",
    description:
      "Supera la tasa del banco con condiciones exclusivas para empresas. **Optimiza tu flujo de caja** maximizando la rentabilidad en cada cambio.",
    image: iconAhorro,
  },
  {
    title: "Facturación inmediata",
    description:
      "Recibe tu factura electrónica al instante y sin errores. **Asegura tu escudo fiscal** cumpliendo con SUNAT en cada operación.",
    image: iconFactura,
  },
  {
    title: "Ejecutivo personalizado",
    description:
      "Gestiona tus operaciones de alto valor directamente por WhatsApp. **Atención humana y experta** para garantizar la liquidez de tu negocio.",
    image: iconSoporte,
  },
  {
    title: "Seguridad y Cumplimiento",
    description:
      "Operaciones 100% bancarizadas bajo la regulación de la SBS. **Garantizamos trazabilidad total** y cero riesgos de fraude para tus fondos.",
    image: iconSeguridad,
  },
] as const;
---

<ContainerSection id="section-beneficios" ariaLabelledby="title-beneficios" bgColor="bg-neutral-100">
  <SectionHeading
    id="title-beneficios"
    shortText="¿Qué te ofrecemos?"
    title="Beneficios exclusivos para la"
    subtitle="gestión financiera de tu negocio"
    align="center"
    description="Una plataforma diseñada para tesoreros, contadores y dueños de empresas."
  />

  <div class="relative max-w-350 mx-auto" aria-label="Beneficios para empresas">
    <Carousel data={cardsBeneficios} visibleDesktop={4} hasOverflow={true}>
      {cardsBeneficios.map((card) => (
        <article class="h-full group/card">
          <div class="flex flex-col gap-4 text-center items-center justify-center border-2 border-neutral-100 rounded-2xl bg-white p-8 h-full transition-all duration-300 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-900/5">
            <Image
              src={card.image}
              alt={card.title}
              width={250}
              height={250}
              loading="lazy"
              class="size-28 md:size-32 -mt-20 drop-shadow-2xl object-contain transition-transform duration-500 group-hover/card:scale-110"
            />
            <h3 class="text-xl font-bold text-neutral-900 mt-2">{card.title}</h3>
            <p set:html={parseSimpleMarkdown(card.description)} class="text-neutral-600 leading-relaxed text-sm" />
          </div>
        </article>
      ))}
    </Carousel>
  </div>
</ContainerSection>
