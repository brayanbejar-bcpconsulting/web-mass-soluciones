---
/**
 * PostCard - Tarjeta de artículo del blog reutilizable
 * Muestra imagen, tags, título, descripción, fecha y tiempo de lectura
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, getTagSlug } from '@/utils/blog';

interface Props {
  /** URL del post */
  href: string;
  /** Título del post */
  title: string;
  /** Descripción/extracto del post */
  description: string;
  /** Imagen de portada */
  image: ImageMetadata;
  /** Fecha de publicación */
  pubDate: Date;
  /** Tags/etiquetas del post */
  tags: string[];
  /** Tiempo de lectura en minutos */
  readingTime: number;
  /** Tamaño de la tarjeta */
  size?: 'default' | 'featured' | 'compact';
  /** Si está marcado como destacado */
  featured?: boolean;
}

const { 
  href, 
  title, 
  description, 
  image, 
  pubDate, 
  tags, 
  readingTime,
  size = 'default',
  featured = false 
} = Astro.props;

const formattedDate = formatDate(pubDate);
const maxTags = size === 'compact' ? 2 : 3;
const displayTags = tags.slice(0, maxTags);

// Clases según tamaño
const cardClasses = {
  default: 'group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col h-full',
  featured: 'group bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300 flex flex-col h-full ring-2 ring-primary-500/20',
  compact: 'group bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col h-full'
};

const imageClasses = {
  default: 'w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300',
  featured: 'w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300',
  compact: 'w-full h-36 object-cover group-hover:scale-105 transition-transform duration-200'
};
---

<article class={cardClasses[size]}>
  <!-- Imagen con overlay -->
  <a href={href} class="relative overflow-hidden block">
    <Image
      src={image}
      alt={title}
      width={400}
      height={size === 'featured' ? 224 : (size === 'compact' ? 144 : 192)}
      class={imageClasses[size]}
      loading="lazy"
    />
    {featured && (
      <span class="absolute top-3 right-3 bg-primary-600 text-white text-xs font-semibold px-2 py-1 rounded-full flex items-center gap-1">
        <svg class="w-3 h-3" aria-hidden="true">
          <use href="/icons.svg#pin"></use>
        </svg>
        Destacado
      </span>
    )}
  </a>

  <!-- Contenido -->
  <div class="p-5 flex flex-col grow">
    <!-- Tags -->
    {displayTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {displayTags.map((tag) => (
          <a
            href={`/blog/tag/${getTagSlug(tag)}`}
            class="text-xs font-medium text-primary-600 bg-primary-50 px-2.5 py-1 rounded-full hover:bg-primary-100 transition-colors"
          >
            {tag}
          </a>
        ))}
        {tags.length > maxTags && (
          <span class="text-xs text-neutral-400">+{tags.length - maxTags}</span>
        )}
      </div>
    )}

    <!-- Título -->
    <h3 class={`font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors line-clamp-2 ${size === 'compact' ? 'text-base' : 'text-lg'}`}>
      <a href={href}>{title}</a>
    </h3>

    <!-- Descripción -->
    <p class={`text-neutral-600 mb-4 grow ${size === 'compact' ? 'text-sm line-clamp-2' : 'text-sm line-clamp-3'}`}>
      {description}
    </p>

    <!-- Footer: Fecha y tiempo de lectura -->
    <div class="flex items-center justify-between text-xs text-neutral-500 pt-3 border-t border-neutral-100 mt-auto">
      <time datetime={pubDate.toISOString()} class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" aria-hidden="true">
          <use href="/icons.svg#calendar"></use>
        </svg>
        {formattedDate}
      </time>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" aria-hidden="true">
          <use href="/icons.svg#clock"></use>
        </svg>
        {readingTime} min de lectura
      </span>
    </div>
  </div>
</article>