---
/**
 * TagList - Lista de tags/etiquetas para filtrado
 * Soporta modo enlace (navegación) y modo botón (filtrado JS)
 */
import { getTagSlug } from '@/utils/blog';

interface Props {
  /** Lista de tags a mostrar */
  tags: string[];
  /** Tag actualmente seleccionado */
  activeTag?: string;
  /** Modo de visualización: 'link' para navegación, 'button' para filtrado JS */
  mode?: 'link' | 'button';
  /** Mostrar opción "Todos" al inicio */
  showAll?: boolean;
  /** URL base para los enlaces (default: /blog/tag/) */
  basePath?: string;
  /** Clase CSS adicional para el contenedor */
  class?: string;
  /** Tamaño de los tags */
  size?: 'sm' | 'md';
}

const { 
  tags, 
  activeTag, 
  mode = 'link', 
  showAll = true,
  basePath = '/blog/tag/',
  class: className = '',
  size = 'md'
} = Astro.props;

const isAllActive = !activeTag;

// Clases base según tamaño
const sizeClasses = {
  sm: 'text-xs px-2.5 py-1',
  md: 'text-sm px-3 py-1.5'
};

const baseClasses = `${sizeClasses[size]} font-medium rounded-full transition-all duration-200 inline-flex items-center gap-1.5`;
const activeClasses = 'bg-primary-600 text-white shadow-md';
const inactiveClasses = 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200';
---

<div 
  class={`flex flex-wrap gap-2 ${className}`}
  role={mode === 'button' ? 'group' : undefined}
  aria-label={mode === 'button' ? 'Filtrar por etiqueta' : undefined}
>
  {showAll && (
    mode === 'link' ? (
      <a
        href="/blog"
        class:list={[baseClasses, isAllActive ? activeClasses : inactiveClasses]}
        aria-current={isAllActive ? 'page' : undefined}
      >
        <svg class="w-3.5 h-3.5" aria-hidden="true">
          <use href="/icons.svg#tag"></use>
        </svg>
        Todos
      </a>
    ) : (
      <button
        type="button"
        class:list={[baseClasses, isAllActive ? activeClasses : inactiveClasses]}
        data-tag=""
        aria-pressed={isAllActive ? 'true' : 'false'}
      >
        <svg class="w-3.5 h-3.5" aria-hidden="true">
          <use href="/icons.svg#tag"></use>
        </svg>
        Todos
      </button>
    )
  )}

  {tags.map((tag) => {
    const tagSlug = getTagSlug(tag);
    const isActive = activeTag === tag || activeTag === tagSlug;
    
    return mode === 'link' ? (
      <a
        href={`${basePath}${tagSlug}`}
        class:list={[baseClasses, isActive ? activeClasses : inactiveClasses]}
        aria-current={isActive ? 'page' : undefined}
      >
        {tag}
      </a>
    ) : (
      <button
        type="button"
        class:list={[baseClasses, isActive ? activeClasses : inactiveClasses]}
        data-tag={tagSlug}
        aria-pressed={isActive ? 'true' : 'false'}
      >
        {tag}
      </button>
    );
  })}
</div>