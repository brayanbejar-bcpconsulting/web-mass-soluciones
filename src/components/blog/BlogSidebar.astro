---
/**
 * BlogSidebar - Sidebar del blog con destacados, tags y orden
 * Componente reutilizable para las páginas del blog
 */
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';
import { formatDate, getSlug } from '@/utils/blog';

interface FeaturedPost {
  id: string;
  title: string;
  pubDate: Date;
  image: ImageMetadata;
}

interface Props {
  /** Posts destacados a mostrar */
  featuredPosts?: FeaturedPost[];
  /** Todos los tags disponibles */
  allTags?: string[];
  /** Tag activo actualmente */
  activeTag?: string;
  /** Modo de los tags: 'link' para navegación, 'button' para JS */
  tagMode?: 'link' | 'button';
  /** Mostrar sección de ordenamiento */
  showSort?: boolean;
  /** Orden actual */
  currentSort?: 'recent' | 'oldest';
  /** Clase CSS adicional */
  class?: string;
}

const { 
  featuredPosts = [], 
  allTags = [],
  activeTag,
  tagMode = 'link',
  showSort = false,
  currentSort = 'recent',
  class: className = ''
} = Astro.props;
---

<aside class={`space-y-6 ${className}`}>
  <!-- Ordenar por -->
  {showSort && (
    <div class="bg-white rounded-xl p-5 shadow-md">
      <h3 class="text-sm font-semibold text-neutral-900 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600" aria-hidden="true">
          <use href="/icons.svg#sort"></use>
        </svg>
        Ordenar por
      </h3>
      <div class="flex gap-2" role="group" aria-label="Ordenar artículos">
        <button
          type="button"
          id="sort-recent"
          class:list={[
            'flex-1 py-2 px-3 text-sm font-medium rounded-lg transition-all',
            currentSort === 'recent' 
              ? 'bg-primary-600 text-white shadow' 
              : 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200'
          ]}
          aria-pressed={currentSort === 'recent' ? 'true' : 'false'}
        >
          Más recientes
        </button>
        <button
          type="button"
          id="sort-oldest"
          class:list={[
            'flex-1 py-2 px-3 text-sm font-medium rounded-lg transition-all',
            currentSort === 'oldest' 
              ? 'bg-primary-600 text-white shadow' 
              : 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200'
          ]}
          aria-pressed={currentSort === 'oldest' ? 'true' : 'false'}
        >
          Más antiguos
        </button>
      </div>
    </div>
  )}

  <!-- Filtrar por etiquetas -->
  {allTags.length > 0 && (
    <div class="bg-white rounded-xl p-5 shadow-md">
      <h3 class="text-sm font-semibold text-neutral-900 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600" aria-hidden="true">
          <use href="/icons.svg#filter"></use>
        </svg>
        Filtrar por etiqueta
      </h3>
      <TagList 
        tags={allTags} 
        activeTag={activeTag} 
        mode={tagMode}
        showAll={true}
        size="sm"
      />
    </div>
  )}

  <!-- Artículos destacados -->
  {featuredPosts.length > 0 && (
    <div class="bg-white rounded-xl p-5 shadow-md">
      <h3 class="text-sm font-semibold text-neutral-900 mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600" aria-hidden="true">
          <use href="/icons.svg#pin"></use>
        </svg>
        Artículos destacados
      </h3>
      <ul class="space-y-4">
        {featuredPosts.map((post) => (
          <li>
            <a
              href={`/blog/${getSlug(post.id)}`}
              class="group flex gap-3 items-start"
            >
              <img
                src={post.image.src}
                alt={post.title}
                width={64}
                height={64}
                class="w-16 h-16 rounded-lg object-cover shrink-0"
                loading="lazy"
              />
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-medium text-neutral-900 group-hover:text-primary-600 transition-colors line-clamp-2">
                  {post.title}
                </h4>
                <time 
                  datetime={post.pubDate.toISOString()}
                  class="text-xs text-neutral-500 mt-1 block"
                >
                  {formatDate(post.pubDate)}
                </time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Newsletter CTA -->
  <div class="bg-linear-to-br from-primary-600 to-primary-700 rounded-xl p-5 text-white">
    <h3 class="font-semibold mb-2">¿Te gusta nuestro contenido?</h3>
    <p class="text-sm text-primary-100 mb-4">
      Recibe las últimas noticias sobre el dólar y consejos financieros.
    </p>
    <a
      href="/beneficios"
      class="inline-flex items-center gap-2 bg-white text-primary-700 font-medium text-sm px-4 py-2 rounded-lg hover:bg-primary-50 transition-colors"
    >
      Ver beneficios
      <svg class="w-4 h-4" aria-hidden="true">
        <use href="/icons.svg#arrow-right"></use>
      </svg>
    </a>
  </div>
</aside>