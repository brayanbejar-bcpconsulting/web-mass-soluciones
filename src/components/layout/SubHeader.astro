---
/**
 * SubHeader - Rediseño Minimalista
 */
import Icon from "@components/ui/Icon.astro";
import { getClientTabs, TRUST_BADGES } from "@utils/navigation";

const { pathname } = Astro.url;

// Usar función centralizada para tabs
const tabs = getClientTabs(pathname);

// Badges de confianza
const badges = TRUST_BADGES;

// Estilos de los Tabs
const tabBase = "relative flex items-center gap-2 px-6 py-3 text-sm font-bold transition-all duration-300 group focus-visible:outline-none";
const tabActive = "text-primary-700";
const tabInactive = "text-neutral-400 hover:text-primary-500";
---

<nav 
  id="sub-header"
  class="hidden lg:block w-full bg-neutral-50 border-b border-neutral-200 z-40"
  aria-label="Navegación por tipo de cliente"
>
  <div class="max-w-350 flex items-center justify-between mx-auto">
    
    <div 
      class="flex items-center" 
      role="tablist"
    >
      {tabs.map((tab) => (
        <a 
          href={tab.href}
          class:list={[tabBase, tab.active ? tabActive : tabInactive]}
          aria-current={tab.active ? 'page' : undefined}
        >
          <Icon name={tab.icon} class:list={["size-4", tab.active ? "text-primary-600" : "text-neutral-400 group-hover:text-primary-400"]} />
          <span>{tab.name}</span>

          {/* Línea indicadora de estado activo */}
          {tab.active ? (
            <div class="absolute bottom-0 left-0 w-full h-0.5 bg-primary-600 shadow-[0_-2px_8px_rgba(22,139,81,0.3)]" />
          ) : (
            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-400 transition-all duration-300 group-hover:w-full" />
          )}
        </a>
      ))}
    </div>

    <aside 
      class="flex items-center gap-6"
      aria-label="Indicadores de confianza"
    >
      {badges.map((badge, index) => (
        <div class="flex items-center gap-2 group/badge">
          <div class="p-1.5 rounded-lg bg-primary-50 text-primary-700 group-hover/badge:bg-primary-100 transition-colors">
            <Icon name={badge.icon} class="size-4" aria-hidden="true" />
          </div>
          <span class="text-xs font-bold text-neutral-600 uppercase tracking-wide">
            {badge.text}
          </span>
          {index < badges.length - 1 && (
            <span class="ml-4 w-1 h-1 bg-neutral-300 rounded-full" aria-hidden="true"></span>
          )}
        </div>
      ))}
    </aside>

  </div>
</nav>

<style>
  /* Suavizado de la transición del sub-header si se usa con scroll scripts */
  #sub-header {
    will-change: transform, opacity;
  }
</style>