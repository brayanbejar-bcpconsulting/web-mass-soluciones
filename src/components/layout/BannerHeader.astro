---
// PromoBanner.astro
---
<section class="overflow-hidden bg-gradient-to-r from-yellow-400 via-yellow-500 to-yellow-600 text-black w-full shadow-md border-b border-black/10 select-none">
  <div class="max-w-7xl mx-auto h-12 flex items-center justify-between px-3 md:px-4">
    <div class="flex items-center gap-x-2 md:gap-x-6 w-full justify-between md:justify-center">
      
      <div class="flex items-center gap-1.5 md:gap-2 shrink-0">
        <span class="text-lg md:text-xl animate-bounce-subtle">🎁</span>
        <span class="font-bold text-[11px] md:text-sm">
          <span class="md:hidden">¡Bono exclusivo!</span> 
          <span class="hidden md:inline">¡Consigue tu bono exclusivo ahora!</span> 
        </span>
      </div>
      <div class="flex items-center gap-2 md:gap-6">
        <a 
          href="https://app.market-dollar.com/register" 
          class="bg-gray-950 text-white text-[9px] md:text-xs font-black py-1.5 px-3 md:px-4 rounded-full shadow-lg active:scale-95 transition-transform whitespace-nowrap"
        >
          ¡CANJEAR YA!
        </a>
        <div 
          class="flex items-center gap-0.5 md:gap-1 font-mono text-[11px] md:text-base font-black bg-black/10 backdrop-blur-sm px-2 md:px-3 py-1 rounded-lg border border-black/5"
          role="timer"
        >
          <span id="promo-minutes">05</span><span class="animate-pulse">:</span><span id="promo-seconds">00</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-bounce-subtle {
    animation: bounce-subtle 2s infinite;
  }
  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
</style>

<script>
  let timerInterval: ReturnType<typeof setInterval> | null = null;

  function initTimer() {
    const MINUTES_DEFAULT = 5;
    const STORAGE_KEY = 'promo_v3_deadline';
    
    const mEl = document.getElementById("promo-minutes");
    const sEl = document.getElementById("promo-seconds");
    if (!mEl || !sEl) return;

    // Limpiar intervalo previo si existe
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }

    // Obtener o crear el deadline
    let deadline = localStorage.getItem(STORAGE_KEY);
    let targetTime = deadline ? parseInt(deadline, 10) : 0;
    const now = Date.now();

    // Si no hay tiempo o ya expiró, resetear a 5 minutos
    if (!targetTime || targetTime <= now) {
      targetTime = now + (MINUTES_DEFAULT * 60 * 1000);
      localStorage.setItem(STORAGE_KEY, targetTime.toString());
    }

    // Función de actualización
    const update = () => {
      const currentTime = Date.now();
      const diff = targetTime - currentTime;

      if (diff <= 0) {
        mEl.textContent = "00";
        sEl.textContent = "00";
        localStorage.removeItem(STORAGE_KEY);
        if (timerInterval) {
          clearInterval(timerInterval);
          timerInterval = null;
        }
        return;
      }

      const m = Math.floor(diff / (1000 * 60));
      const s = Math.floor((diff / 1000) % 60);
      mEl.textContent = m.toString().padStart(2, '0');
      sEl.textContent = s.toString().padStart(2, '0');
    };

    // Primera actualización inmediata
    update();
    
    // Iniciar intervalo
    timerInterval = setInterval(update, 1000);
  }

  // Para carga inicial (sin View Transitions)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimer);
  } else {
    initTimer();
  }

  // Para navegación con View Transitions (si están habilitadas)
  document.addEventListener('astro:page-load', initTimer);
  
  // Limpieza antes de navegación
  document.addEventListener('astro:before-preparation', () => {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  });
</script>