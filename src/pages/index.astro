---
import Testimonios from "@components/Testimonios.astro"
import TendenciaDolar from "@/components/TendenciaDolar.astro";
import BannerBancos from "@/components/sections/page-home/BannerBancos.astro";
import ComoFunciona from "@/components/sections/page-home/ComoFunciona.astro";
import HeroHome from "@/components/sections/page-home/HeroHome.astro";
import PorqueElegirnos from "@/components/sections/page-home/PorqueElegirnos.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import FAQSection from "@/components/sections/page-home/FAQSection.astro";

// Schema WebSite con SearchAction para habilitar Sitelinks Search Box
const schemaWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Mass Soluciones",
  "url": "https://market-dollar.com",
  "description": "Casa de cambio online en Perú. Cambia dólares a soles con las mejores tasas, seguridad bancaria y soporte 24/7.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://market-dollar.com/blog?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// Schema Organization/LocalBusiness
const schemaOrganization = {
  "@context": "https://schema.org",
  "@type": ["FinancialService", "LocalBusiness"],
  "name": "Mass Soluciones",
  "legalName": "Mass Soluciones E.I.R.L.",
  "description": "Casa de cambio online regulada por la SBS. Cambiamos dólares a soles con las mejores tasas del mercado peruano. Cobertura nacional con local en Huaral, Lima.",
  "foundingDate": "1993",
  "url": "https://market-dollar.com",
  "logo": "https://market-dollar.com/logotipo.webp",
  "image": "https://market-dollar.com/og-market-dollar.jpg",
  "telephone": "+51933214054",
  "email": "marketdollar@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Cahuas 595",
    "addressLocality": "Huaral",
    "addressRegion": "Lima",
    "postalCode": "15201",
    "addressCountry": "PE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-11.493334788721851",
    "longitude": "-77.20558442153708"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Perú"
  },
  "currenciesAccepted": "USD, PEN",
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "23:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/marketdollar",
    "https://www.instagram.com/marketdollar",
    "https://www.linkedin.com/company/marketdollar",
    "https://www.tiktok.com/@marketdollar"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+51933214054",
    "contactType": "Atención al Cliente",
    "areaServed": "PE",
    "availableLanguage": ["Spanish"],
    "contactOption": "TollFree"
  }
};
---

<MainLayout
  title="Mass Soluciones | Tipo de Cambio de Dólar a Soles Online en Perú"
  description="Cambia dólares y soles en minutos con la tasa más competitiva del mercado. Registrados en la SBS. Operaciones seguras, rápidas y sin comisiones ocultas."
>
  <HeroHome />
  <BannerBancos />
  <ComoFunciona />
  <PorqueElegirnos />
  <TendenciaDolar />
  <Testimonios />
  <FAQSection />
</MainLayout>