import MainLayout from "@layouts/MainLayout.astro"
import QueNosDiferencia from "@/components/sections/page-nosotros/QueNosDiferencia.astro";

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Nosotros" }
];

const schemaOrganization = {
  "@context": "https://schema.org",
  "@type": ["FinancialService", "LocalBusiness"],
  "name": "Mass Soluciones",
  "legalName": "Mass Soluciones E.I.R.L.",
  "description": "Casa de cambio online con 30 años de experiencia en cambio de divisas en Perú. Plataforma 100% digital, regulada por la SBS con cobertura nacional.",
  "foundingDate": "1993",
  "url": "https://market-dollar.com/nosotros",
  "logo": "https://market-dollar.com/logo.webp",
  "image": "https://market-dollar.com/og-market-dollar.jpg",
  "telephone": "+51933214054",
  "email": "marketdollar@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Cahuas 595",
    "addressLocality": "Huaral",
    "addressRegion": "Lima",
    "postalCode": "15201",
    "addressCountry": "PE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-11.493334788721851",
    "longitude": "-77.20558442153708"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Perú"
  },
  "currenciesAccepted": "USD, PEN",
  "priceRange": "$$",
  "sameAs": [
    "https://www.facebook.com/marketdollar",
    "https://www.instagram.com/marketdollar",
    "https://www.linkedin.com/company/marketdollar",
    "https://www.tiktok.com/@marketdollar"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+51933214054",
    "contactType": "Atención al Cliente",
    "areaServed": "PE",
    "availableLanguage": ["Spanish"]
  }
};
---

<MainLayout
  title="Mass Soluciones | 30 años cambiando divisas en Perú"
  description="30 años de confianza en cambio de dólares. Plataforma digital regulada por SBS con mejores tasas para personas y empresas. ¡Cambia seguro!"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrganization)} />
  
  <HeroNosotros />
  <NuestraHistoria />
  <CifrasExcelencia />
  <QueNosDiferencia />
  <CTABeneficios />
